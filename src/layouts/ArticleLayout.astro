---
// Страница статьи: хлебные крошки, заголовок, вопрос, метаданные, оглавление, тело, источники и связанные темы.
// Раздел «Источники» — часть тела MDX; предварительные знания и связанные темы берутся из frontmatter.
import ArticleGraph from '@/components/ArticleGraph.astro';
import Icon from '@/components/Icon.astro';
import TagList from '@/components/TagList.astro';
import TextAlignToggle from '@/components/TextAlignToggle.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { ArticleData } from '@/lib/articles';
import type { TocItem } from '@/lib/headings';
import { resolveTarget } from '@/lib/links';
import { tags } from '@/data/tags';
import { topics } from '@/data/topics';
import type { ArticleDates } from '@/lib/article-dates';
import type { LocalGraph } from '@/lib/graph';
import type { SeriesPosition } from '@/lib/first-steps';
import type { NavTrack } from '@/lib/track-navigation';
import { formatUpdatedDate } from '@/lib/format-date';
import { articleStructuredData, serializeJsonLd } from '@/lib/structured-data';
import { articlesLabel, materialsHref } from '@/lib/materials';
import { prerequisitesInitScript } from '@/lib/prerequisites';
import { withBase } from '@/lib/urls';
import { siteConfig } from '@/site.config';
import '@/styles/code.css';
import '@/styles/math.css';

interface Props {
  data: ArticleData;
  toc: TocItem[];
  /** Публикация и последнее дополнение из журнала; без публикации — «Черновик». */
  dates: ArticleDates;
  readingMinutes: number;
  /** Этапы треков, куда входит статья или её раздел; без вхождений строка «В треках» не выводится. */
  articleTracks?: {
    slug: string;
    title: string;
    stageId: string;
    stageNumber: number;
    href: string;
  }[];
  /** Полный порядок элементов треков статьи для блока «Трек» по адресу. */
  trackNav?: NavTrack[];
  /** Положение в серии «Первое знакомство»; у статей вне серии не задаётся. */
  series?: SeriesPosition | null;
  /** Блок «Связи»: окрестность статьи и связи списком; без трёх соседей не задаётся. */
  graph?: {
    local: LocalGraph;
    outs: { title: string; href: string }[];
    ins: { title: string; href: string }[];
  } | null;
}

const {
  data,
  toc,
  dates,
  readingMinutes,
  articleTracks = [],
  trackNav = [],
  series = null,
  graph = null,
} = Astro.props;
const group = topics.find((topic) => topic.id === data.topic)!;
const prerequisites = data.prerequisites ?? [];
// Порядок тегов — как во frontmatter; схема уже отклонила неизвестные.
const articleTags = data.tags.map((id) => tags.find((tag) => tag.id === id)!);

const links = (items: typeof data.related) =>
  items.map((item) => ({
    ...item,
    href: resolveTarget(item.target),
    external: 'url' in item.target,
  }));

const absolute = (path: string) => new URL(withBase(path), Astro.site).href;
const structuredData = articleStructuredData({
  url: absolute(`/${data.slug}/`),
  title: data.title,
  description: data.question,
  image: absolute(siteConfig.ogImage),
  published: dates.published,
  modified: dates.addition?.date,
  keywords: articleTags.map((tag) => tag.title),
  site: { name: siteConfig.name, url: absolute('/') },
  // Те же ступени, что в видимых хлебных крошках, плюс сама статья.
  breadcrumbs: [
    { name: 'Главная', url: absolute('/') },
    { name: group.title, url: absolute(materialsHref(group.id)) },
    { name: data.title, url: absolute(`/${data.slug}/`) },
  ],
});
---

<BaseLayout
  title={data.title}
  description={data.question}
  section="materials"
  article={{ published: dates.published, modified: dates.addition?.date }}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={serializeJsonLd(structuredData)}
  />
  <div class="progress" data-reading-progress aria-hidden="true" hidden></div>
  <main id="content" data-pagefind-body>
    <div class="page">
      <nav class="breadcrumbs" aria-label="Хлебные крошки" data-pagefind-ignore>
        <ol>
          <li class="home">
            <a href={withBase('/')}>Главная</a>
            <Icon name="chevron-right" size={14} />
          </li>
          <li class="group">
            <a href={withBase(materialsHref(group.id))}>
              <Icon name="arrow-left" size={16} />
              {group.title}
            </a>
          </li>
        </ol>
      </nav>

      <header class:list={['head', { 'has-series': series }]}>
        {series && (
          <a class="series-label" href={`${withBase('/')}#first-steps`} data-pagefind-ignore>
            Первое знакомство · {series.number} из {series.total}
          </a>
        )}
        <h1>{data.title}</h1>
        <p class="question">{data.question}</p>
        {/* В DOM метаданные идут сразу после лида; от 1280 px сетка выносит их в правое поле. */}
        <aside class="about" aria-label="О статье" data-pagefind-ignore>
          <div class="meta-row">
            <div class="meta">
              {dates.published ? (
                <span>
                  Опубликовано{' '}
                  <time datetime={dates.published}>{formatUpdatedDate(dates.published)}</time>
                </span>
              ) : (
                <span>Черновик</span>
              )}
              {dates.addition && (
                <span>
                  Дополнено{' '}
                  <a href={withBase(dates.addition.path)}>
                    <time datetime={dates.addition.date}>
                      {formatUpdatedDate(dates.addition.date)}
                    </time>
                  </a>
                </span>
              )}
              <span class="reading">
                <Icon name="clock" size={16} />
                {readingMinutes} мин чтения
              </span>
            </div>
            <TextAlignToggle compact />
          </div>
          {articleTracks.length > 0 && (
            <p class="in-tracks" data-in-tracks data-pagefind-ignore>
              <span class="in-tracks-label">В треках</span>
              {articleTracks.map((item) => (
                <a href={item.href}>
                  {item.title}, этап {item.stageNumber}
                </a>
              ))}
            </p>
          )}
        </aside>
        <TagList tags={articleTags} label="Теги" all />
      </header>

      {toc.length > 0 && (
        <div class="toc-cell" data-pagefind-ignore>
          <TextAlignToggle />
          <div class="toc-sticky">
            <nav class="toc" aria-label="Содержание" data-toc>
              <details open>
                <summary>
                  <span data-toc-label>Содержание</span>
                  <Icon name="chevron-down" size={16} />
                </summary>
                <ol>
                  {toc.map((item) => (
                    <li data-depth={item.depth}>
                      <a href={`#${item.slug}`}>{item.text}</a>
                    </li>
                  ))}
                </ol>
              </details>
            </nav>
          </div>
        </div>
      )}

      <article class="body" data-article-body>
        {prerequisites.length > 0 && (
          <aside class="prerequisites" aria-label="Что нужно знать заранее" data-pagefind-ignore>
            <details data-prerequisites>
              <summary>
                <Icon name="chevron-right" size={16} />
                <span class="label">Что нужно знать заранее</span>
                <span class="count">{articlesLabel(prerequisites.length)}</span>
              </summary>
              <ul>
                {links(prerequisites).map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                    <span class="note">{item.description}</span>
                  </li>
                ))}
              </ul>
            </details>
            <script is:inline set:html={prerequisitesInitScript} />
          </aside>
        )}
        <div class="prose">
          <slot />
        </div>
        {series && (
          <nav
            class="series-nav"
            aria-label="Первое знакомство"
            data-series-nav
            data-pagefind-ignore
          >
            {series.next && (
              <a class="series-next" href={withBase(`/${series.next.slug}/`)}>
                <span class="series-hint">
                  Дальше в знакомстве · {series.number + 1} из {series.total}
                </span>
                <span class="series-title">{series.next.title}</span>
              </a>
            )}
            <a class="series-tracks" href={withBase('/tracks/')}>
              <span class="series-hint">Хотите глубже?</span>
              <span class="series-title">Выберите трек под свою задачу</span>
            </a>
          </nav>
        )}
        {trackNav.length > 0 && (
          <>
            <nav
              class="track-nav"
              data-track-nav
              data-article={data.slug}
              data-pagefind-ignore
              hidden
            />
            <script
              type="application/json"
              data-track-nav-data
              set:html={JSON.stringify(trackNav).replace(/</g, '\\u003c')}
            />
          </>
        )}
        {graph && <ArticleGraph title={data.title} {...graph} />}
        <section class="related" aria-labelledby="related-title" data-pagefind-ignore>
          <h2 id="related-title">Связанные темы</h2>
          <ul>
            {links(data.related).map((item) => (
              <li>
                <a href={item.href}>
                  <span class="text">
                    <span>{item.label}</span>
                    <span class="note">{item.description}</span>
                  </span>
                  <Icon name={item.external ? 'external-link' : 'chevron-right'} size={16} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      </article>
    </div>
  </main>
  <button type="button" class="to-top" data-back-to-top hidden>
    <Icon name="arrow-up" size={18} />
    <span class="to-top-label">Наверх</span>
  </button>
  <div class="copy-status" role="status" data-copy-status hidden></div>
</BaseLayout>

<script>
  import { initCodeBlocks } from '@/lib/code-block-controller';
  import { initHeadingLinks } from '@/lib/heading-links-controller';
  import { initPrerequisites } from '@/lib/prerequisites-controller';
  import { initReadingProgress } from '@/lib/reading-progress-controller';
  import { initToc } from '@/lib/toc-controller';
  import { initTrackNavigation } from '@/lib/track-navigation-controller';

  initToc();
  initHeadingLinks();
  initCodeBlocks();
  initReadingProgress();
  initTrackNavigation();
  initPrerequisites();
</script>

<style>
  /* Сетка макета 3-article: оглавление 240 px | зазор | текст 680 px; на узком экране одна колонка. */
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-6);
    width: min(var(--container-max), 100% - 2 * var(--page-gutter));
    margin-inline: auto;
    padding-top: var(--space-4);
  }

  .breadcrumbs,
  .head,
  .toc-cell,
  .body {
    min-width: 0;
    max-width: var(--content-width);
    width: 100%;
    margin-inline: auto;
  }

  .breadcrumbs ol,
  .toc ol,
  .prerequisites ul,
  .related ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
  }

  .breadcrumbs .group a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Смартфон: только родительская группа со стрелкой «назад»; планшет и десктоп: Главная › группа. */
  .breadcrumbs .group :global(.icon) {
    display: none;
  }

  @media (width < 600px) {
    .breadcrumbs .home {
      display: none;
    }

    .breadcrumbs .group :global(.icon) {
      display: inline;
    }
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: -8px;
  }

  h1 {
    margin: 0;
  }

  .question {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    font-style: italic;
    line-height: var(--leading-normal);
    text-wrap: pretty;
  }

  /* «О статье» до 1280 px — строки под лидом: даты и время чтения, затем «В треках». */
  .about {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Смартфон: переключатель выравнивания — справа в строке метаданных. */
  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 14px;
  }

  .series-label {
    align-self: flex-start;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .series-nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    font-family: var(--font-ui);
  }

  .series-next,
  .series-tracks {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .series-next {
    border-color: var(--color-border-strong);
    background: var(--color-surface);
  }

  .series-next:hover,
  .series-tracks:hover {
    border-color: var(--color-accent);
  }

  .series-hint {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .series-title {
    font-family: var(--font-text);
    font-weight: 600;
    font-size: 17px;
    color: var(--color-text);
  }

  @media (width >= 600px) {
    .series-nav:has(.series-next) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .in-tracks {
    display: flex;
    flex-wrap: wrap;
    gap: 2px var(--space-3);
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 14px;
  }

  /* Блок строится в браузере по адресу; стили глобальные, потому что узлы создаёт скрипт. */
  .track-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: 18px 20px;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    font-family: var(--font-ui);
  }

  .track-nav[hidden] {
    display: none;
  }

  .track-nav :global(.summary) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    color: var(--color-text-muted);
    font-size: 13px;
  }

  .track-nav :global(.steps) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }

  .track-nav :global(.step) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 44px;
    padding: 10px 14px;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .track-nav :global(.step:hover) {
    border-color: var(--color-accent);
  }

  .track-nav :global(.step.next) {
    text-align: end;
  }

  .track-nav :global(.step-label),
  .track-nav :global(.step-note) {
    color: var(--color-text-muted);
    font-size: 12px;
  }

  .track-nav :global(.step-title) {
    font-family: var(--font-text);
    font-size: 16px;
    font-weight: 600;
    line-height: var(--leading-snug);
  }

  @media (width >= 600px) {
    .track-nav :global(.steps) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .track-nav :global(.step.next:only-child) {
      grid-column: 2;
    }
  }

  .in-tracks-label::after {
    content: ':';
  }

  .reading {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  /* Смартфон и планшет: оглавление — рамка под метаданными, раскрывается кнопкой-summary. Без JS открыто. */
  .toc {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    font-family: var(--font-ui);
  }

  .toc details {
    padding: var(--space-1) var(--space-2) var(--space-2);
  }

  .toc summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 10px;
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .toc summary::-webkit-details-marker {
    display: none;
  }

  .toc summary :global(.icon) {
    transition: transform var(--duration-fast);
  }

  .toc details[open] summary :global(.icon) {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .toc summary :global(.icon) {
      transition: none;
    }
  }

  .toc ol {
    max-height: 60dvh;
    overflow-y: auto;
  }

  .toc a {
    display: block;
    padding: 6px 10px;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: 14px;
    line-height: 1.4;
    text-decoration: none;
  }

  .toc li[data-depth='3'] a {
    padding-inline-start: 24px;
    font-size: 13.5px;
  }

  .toc a:hover {
    color: var(--color-accent-hover);
  }

  .toc a[aria-current='location'] {
    background: var(--color-accent-soft);
    color: var(--color-text);
    font-weight: 600;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Свёрнут по умолчанию; в заголовке — число статей. Без JS раскрывается как обычный <details>. */
  .prerequisites {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    font-family: var(--font-ui);
  }

  .prerequisites summary {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }

  .prerequisites summary::-webkit-details-marker {
    display: none;
  }

  .prerequisites summary:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .prerequisites summary :global(.icon) {
    flex: none;
    color: var(--color-text-muted);
    transition: transform var(--duration-fast);
  }

  .prerequisites details[open] summary :global(.icon) {
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .prerequisites summary :global(.icon) {
      transition: none;
    }
  }

  .prerequisites .count {
    margin-inline-start: auto;
    color: var(--color-text-muted);
    font-size: 13px;
    white-space: nowrap;
  }

  .label,
  .related h2 {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  /* Пункты выровнены по подписи: 20 px поля + 16 px значок + 10 px зазор. */
  .prerequisites ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 0 var(--space-5) var(--space-4) 46px;
    font-size: 15px;
    line-height: var(--leading-normal);
  }

  .prerequisites li {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    align-items: baseline;
  }

  .prerequisites a {
    font-weight: 500;
  }

  .note {
    color: var(--color-text-muted);
  }

  .related {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: var(--space-4);
    font-family: var(--font-ui);
  }

  .related a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 44px;
    border-bottom: var(--border-width) solid var(--color-border);
    color: var(--color-text);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  .related a:hover {
    color: var(--color-link);
  }

  .related .text {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-2);
  }

  .related .note {
    font-size: 13px;
    font-weight: 400;
  }

  @media (width >= 1024px) {
    .page {
      grid-template-columns: var(--toc-width) minmax(0, var(--content-width));
      column-gap: var(--space-7);
      justify-content: start;
      padding-top: 40px;
    }

    .breadcrumbs,
    .head,
    .body {
      grid-column: 2;
      margin-inline: 0;
    }

    /* Колонка оглавления занимает всю высоту статьи и начинается на уровне заголовка.
       Переключатель «Текст» стоит над оглавлением и уходит вверх при прокрутке, оглавление прилипает под шапкой. */
    .toc-cell {
      grid-column: 1;
      grid-row: 1 / span 3;
      display: flex;
      flex-direction: column;
      gap: 28px;
      max-width: none;
      margin-inline: 0;
      /* Высота крошек и зазор до заголовка: верх подписи «Текст» на уровне H1. */
      padding-top: 39px;
    }

    /* Список прокручивается сам, если длиннее окна. */
    .toc-sticky {
      position: sticky;
      top: 88px;
      max-height: calc(100dvh - 88px - var(--space-6));
      display: flex;
      flex-direction: column;
    }

    /* Заголовок «Содержание» — подпись, не кнопка. */
    .toc {
      display: flex;
      flex-direction: column;
      min-height: 0;
      border: 0;
      border-radius: 0;
      background: none;
    }

    .toc details {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 0;
    }

    .toc summary {
      min-height: 0;
      padding: var(--space-2) 10px;
      color: var(--color-text-muted);
      font-size: 12px;
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      cursor: default;
      pointer-events: none;
    }

    .toc summary :global(.icon) {
      display: none;
    }

    /* 40 px — высота подписи «Содержание». */
    .toc ol {
      position: relative;
      max-height: calc(100dvh - 88px - var(--space-6) - 40px);
    }
  }

  /* Правое поле есть у каждой статьи: метаданные сверху, заметки ниже. 240 + 24 + 680 + 48 + 208 = 1200 px.
     Текст сужается при нехватке места; на статьях с заметками широкие блоки используют правое поле. */
  @media screen and (width >= 1280px) {
    .page {
      grid-template-columns: 240px minmax(0, 1fr);
      column-gap: var(--space-6);
    }

    .body {
      max-width: none;
    }

    :is(.breadcrumbs, .prerequisites, .series-nav, .track-nav, .related),
    .page :global(.article-graph) {
      max-width: min(var(--content-width), 100% - 256px);
    }

    .prose > :global(*) {
      width: calc(100% - 256px);
      box-sizing: border-box;
    }

    .prose > :global(.margin-note-block) {
      width: 100%;
    }

    .page:has(:global(.margin-note)) .prose > :global(:is(figure, .data-table)) {
      width: min(var(--wide-width), 100%);
    }

    /* Заголовок, лид и теги — в колонке текста; «О статье» — в правом поле с верхом на уровне заголовка.
       Поле позиционировано абсолютно в своей ячейке сетки: высоту заголовка оно не меняет и, если длиннее,
       свисает рядом с началом текста. */
    .head {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 208px;
      column-gap: 48px;
      max-width: none;
    }

    .head > :not(.about),
    .head > :global(.tag-list) {
      grid-column: 1;
    }

    .about {
      position: absolute;
      inset: 0 0 auto;
      grid-column: 2;
      grid-row: 1;
      gap: 20px;
      color: var(--color-text-muted);
      font-family: var(--font-ui);
      font-size: 14px;
      line-height: var(--leading-normal);
    }

    .head.has-series .about {
      grid-row: 2;
    }

    .about .meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }

    /* Дата — отдельной строкой под «Опубликовано» и «Дополнено». */
    .about .meta > span:has(time) {
      display: flex;
      flex-direction: column;
    }

    .about .meta time {
      color: var(--color-text);
      white-space: nowrap;
    }

    .about .reading {
      margin-top: 6px;
    }

    .about .in-tracks {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding-top: var(--space-4);
      border-top: var(--border-width) solid var(--color-border);
    }

    /* Подпись группы — как у «Содержания». */
    .in-tracks-label {
      margin-bottom: 4px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
    }

    .in-tracks-label::after {
      content: none;
    }
  }

  @media print {
    .page {
      grid-template-columns: minmax(0, 1fr);
    }

    :is(.breadcrumbs, .head, .body) {
      grid-column: 1;
    }

    .page:has(:global(.margin-note)) .toc-cell {
      display: none;
    }
  }

  /* Тело статьи приходит из MDX без классов компонента. */
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .prose > :global(*) {
    margin: 0;
  }

  .prose > :global(p) {
    text-wrap: pretty;
  }

  /* «По ширине» — только абзацы основного текста (в том числе рядом с заметкой на полях) и врезок «Упрощение» и «Типичная ошибка»; последняя строка слева. */
  :global(html[data-text-align='justify']) .prose > :global(p),
  :global(html[data-text-align='justify']) .prose > :global(.margin-note-block > p),
  :global(html[data-text-align='justify'])
    :global(.callout:is([data-type='simplification'], [data-type='mistake']) .callout-body > p) {
    text-align: justify;
    text-align-last: left;
    hyphens: auto;
  }

  .prose > :global(h2) {
    margin-top: var(--space-6);
  }

  .prose > :global(h3) {
    margin-top: var(--space-4);
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    scroll-margin-top: 88px;
  }

  /* Целевой раздел выделяется так же, как термин глоссария; геометрия текста не меняется. */
  .prose :global(:is(h2, h3, h4):target) {
    border-radius: 6px;
    background: var(--color-accent-soft);
    box-shadow: 0 0 0 6px var(--color-accent-soft);
  }

  /* Ссылка `#` видна при наведении на заголовок и при фокусе; на тач-экране без hover остаётся приглушённой. */
  .prose :global(.heading-link) {
    margin-inline-start: 0.4em;
    padding-inline: 0.2em;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 0.75em;
    font-weight: 400;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .prose :global(.heading-link::before) {
    content: '#';
  }

  .prose :global(:is(h2, h3, h4):hover .heading-link),
  .prose :global(.heading-link:focus-visible) {
    opacity: 1;
  }

  .prose :global(.heading-link:hover) {
    color: var(--color-link);
  }

  @media (hover: none) {
    .prose :global(.heading-link) {
      opacity: 0.6;
    }
  }

  /* Полоса прогресса: под шапкой, не занимает место в потоке; `top` задаёт скрипт по высоте шапки. */
  .progress {
    position: fixed;
    inset-inline: 0;
    top: 57px;
    z-index: var(--z-sticky);
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
    pointer-events: none;
  }

  .to-top {
    position: fixed;
    inset-block-end: var(--space-5);
    inset-inline-end: var(--space-4);
    z-index: var(--z-sticky);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: 14px;
    cursor: pointer;
  }

  .to-top[hidden] {
    display: none;
  }

  .to-top:hover {
    color: var(--color-accent-hover);
  }

  /* Смартфон: только стрелка, подпись остаётся для скринридера. */
  @media (width < 600px) {
    .to-top-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .copy-status {
    position: fixed;
    inset-block-end: var(--space-5);
    inset-inline: var(--space-4);
    z-index: var(--z-toast);
    width: fit-content;
    max-width: calc(100vw - 2 * var(--space-4));
    margin-inline: auto;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .copy-status[data-state='success'] {
