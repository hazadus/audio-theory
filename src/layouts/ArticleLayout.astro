  }

  .copy-status[data-state='error'] {
    background: var(--color-surface-raised);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .prose > :global(ul),
  .prose > :global(ol) {
    padding-inline-start: 1.4em;
  }

  /* «Источники» — компактный раздел в конце: малый заголовок капителью и список 15 px. */
  .prose > :global(h2#sources) {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 13px;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .prose > :global(h2#sources ~ ul),
  .prose > :global(h2#sources ~ ol) {
    font-size: 15px;
    line-height: 1.5;
  }

  .prose > :global(h2#sources ~ ul > li + li),
  .prose > :global(h2#sources ~ ol > li + li) {
    margin-top: var(--space-2);
  }

  .prose :global(img),
  .prose :global(svg),
  .prose :global(table) {
    max-width: 100%;
  }

  /* Подписи и списки с кеглем в px получают печатный кегль в пунктах, пропорционально тексту 10pt. */
  @media print {
    .meta,
    .in-tracks {
      font-size: 8pt;
    }

    .label,
    .related h2,
    .related .note,
    .prose > :global(h2#sources) {
