---
// Страница статьи: хлебные крошки, заголовок, вопрос, метаданные, оглавление, тело, источники и связанные темы.
// Раздел «Источники» — часть тела MDX; предварительные знания и связанные темы берутся из frontmatter.
import Icon from '@/components/Icon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { ArticleData } from '@/lib/articles';
import type { TocItem } from '@/lib/headings';
import { resolveTarget } from '@/lib/links';
import { topics } from '@/data/topics';
import { formatUpdatedDate } from '@/lib/format-date';
import { materialsHref } from '@/lib/materials';
import { withBase } from '@/lib/urls';
import '@/styles/code.css';
import '@/styles/math.css';

interface Props {
  data: ArticleData;
  toc: TocItem[];
  /** ISO-дата последнего коммита файла; `null` — «Черновик». */
  updated: string | null;
  readingMinutes: number;
}

const { data, toc, updated, readingMinutes } = Astro.props;
const group = topics.find((topic) => topic.id === data.topic)!;
const prerequisites = data.prerequisites ?? [];

const links = (items: typeof data.related) =>
  items.map((item) => ({
    ...item,
    href: resolveTarget(item.target),
    external: 'url' in item.target,
  }));
---

<BaseLayout title={data.title} section="materials">
  <div class="progress" data-reading-progress aria-hidden="true" hidden></div>
  <main id="content" data-pagefind-body>
    <div class="page">
      <nav class="breadcrumbs" aria-label="Хлебные крошки" data-pagefind-ignore>
        <ol>
          <li class="home">
            <a href={withBase('/')}>Главная</a>
            <Icon name="chevron-right" size={14} />
          </li>
          <li class="group">
            <a href={withBase(materialsHref(group.id))}>
              <Icon name="arrow-left" size={16} />
              {group.title}
            </a>
          </li>
        </ol>
      </nav>

      <header class="head">
        <h1>{data.title}</h1>
        <p class="question">{data.question}</p>
        <div class="meta">
          {updated ? (
            <span data-pagefind-ignore>
              Обновлено <time datetime={updated.slice(0, 10)}>{formatUpdatedDate(updated)}</time>
            </span>
          ) : (
            <span data-pagefind-ignore>Черновик</span>
          )}
          <span class="reading" data-pagefind-ignore>
            <Icon name="clock" size={16} />
            {readingMinutes} мин чтения
          </span>
          <ul class="tags" aria-label="Теги">
            {data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </div>
      </header>

      {toc.length > 0 && (
        <div class="toc-cell" data-pagefind-ignore>
          <nav class="toc" aria-label="Содержание" data-toc>
            <details open>
              <summary>
                <span data-toc-label>Содержание</span>
                <Icon name="chevron-down" size={16} />
              </summary>
              <ol>
                {toc.map((item) => (
                  <li data-depth={item.depth}>
                    <a href={`#${item.slug}`}>{item.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        </div>
      )}

      <article class="body" data-article-body>
        {prerequisites.length > 0 && (
          <aside class="prerequisites" aria-label="Что нужно знать заранее" data-pagefind-ignore>
            <div class="label">Что нужно знать заранее</div>
            <ul>
              {links(prerequisites).map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                  <span class="note">{item.description}</span>
                </li>
              ))}
            </ul>
          </aside>
        )}
        <div class="prose">
          <slot />
        </div>
        <section class="related" aria-labelledby="related-title" data-pagefind-ignore>
          <h2 id="related-title">Связанные темы</h2>
          <ul>
            {links(data.related).map((item) => (
              <li>
                <a href={item.href}>
                  <span class="text">
                    <span>{item.label}</span>
                    <span class="note">{item.description}</span>
                  </span>
                  <Icon name={item.external ? 'external-link' : 'chevron-right'} size={16} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      </article>
    </div>
  </main>
  <button type="button" class="to-top" data-back-to-top hidden>
    <Icon name="arrow-up" size={18} />
    <span class="to-top-label">Наверх</span>
  </button>
  <div class="copy-status" role="status" data-copy-status hidden></div>
</BaseLayout>

<script>
  import { initCodeBlocks } from '@/lib/code-block-controller';
  import { initHeadingLinks } from '@/lib/heading-links-controller';
  import { initReadingProgress } from '@/lib/reading-progress-controller';
  import { initToc } from '@/lib/toc-controller';

  initToc();
  initHeadingLinks();
  initCodeBlocks();
  initReadingProgress();
</script>

<style>
  /* Сетка макета 3-article: оглавление 240 px | зазор | текст 680 px; на узком экране одна колонка. */
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-6);
    width: min(var(--container-max), 100% - 2 * var(--page-gutter));
    margin-inline: auto;
    padding-top: var(--space-4);
  }

  .breadcrumbs,
  .head,
  .toc-cell,
  .body {
    min-width: 0;
    max-width: var(--content-width);
    width: 100%;
    margin-inline: auto;
  }

  .breadcrumbs ol,
  .tags,
  .toc ol,
  .prerequisites ul,
  .related ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
  }

  .breadcrumbs .group a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Смартфон: только родительская группа со стрелкой «назад»; планшет и десктоп: Главная › группа. */
  .breadcrumbs .group :global(.icon) {
    display: none;
  }

  @media (width < 600px) {
    .breadcrumbs .home {
      display: none;
    }

    .breadcrumbs .group :global(.icon) {
      display: inline;
    }
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: -8px;
  }

  h1 {
    margin: 0;
  }

  .question {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    font-style: italic;
    line-height: var(--leading-normal);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 14px;
  }

  .reading {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: var(--text-xs);
  }

  .tags li {
    padding: 2px var(--space-2);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
  }

  /* Смартфон и планшет: оглавление — рамка под метаданными, раскрывается кнопкой-summary. Без JS открыто. */
  .toc {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    font-family: var(--font-ui);
  }

  .toc details {
    padding: var(--space-1) var(--space-2) var(--space-2);
  }

  .toc summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 10px;
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .toc summary::-webkit-details-marker {
    display: none;
  }

  .toc summary :global(.icon) {
    transition: transform var(--duration-fast);
  }

  .toc details[open] summary :global(.icon) {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .toc summary :global(.icon) {
      transition: none;
    }
  }

  .toc ol {
    max-height: 60dvh;
    overflow-y: auto;
  }

  .toc a {
    display: block;
    padding: 6px 10px;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: 14px;
    line-height: 1.4;
    text-decoration: none;
  }

  .toc li[data-depth='3'] a {
    padding-inline-start: 24px;
    font-size: 13.5px;
  }

  .toc a:hover {
    color: var(--color-accent-hover);
  }

  .toc a[aria-current='location'] {
    background: var(--color-accent-soft);
    color: var(--color-text);
    font-weight: 600;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .prerequisites {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    font-family: var(--font-ui);
  }

  .label,
  .related h2 {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .prerequisites ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: 15px;
    line-height: var(--leading-normal);
  }

  .prerequisites li {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    align-items: baseline;
  }

  .prerequisites a {
    font-weight: 500;
  }

  .note {
    color: var(--color-text-muted);
  }

  .related {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: var(--space-4);
    font-family: var(--font-ui);
  }

  .related a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 44px;
    border-bottom: var(--border-width) solid var(--color-border);
    color: var(--color-text);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  .related a:hover {
    color: var(--color-link);
  }

  .related .text {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-2);
  }

  .related .note {
    font-size: 13px;
    font-weight: 400;
  }

  @media (width >= 1024px) {
    .page {
      grid-template-columns: var(--toc-width) minmax(0, var(--content-width));
      column-gap: var(--space-7);
      justify-content: start;
      padding-top: 40px;
    }

    .breadcrumbs,
    .head,
    .body {
      grid-column: 2;
      margin-inline: 0;
    }

    /* Колонка оглавления занимает всю высоту статьи, а список прилипает под шапкой при прокрутке. */
    .toc-cell {
      grid-column: 1;
      grid-row: 1 / span 3;
      max-width: none;
      margin-inline: 0;
      padding-top: 180px;
    }

    /* Заголовок «Содержание» — подпись, не кнопка; список прокручивается сам, если длиннее окна. */
    .toc {
      position: sticky;
      top: 88px;
      max-height: calc(100dvh - 88px - var(--space-6));
      display: flex;
      flex-direction: column;
      border: 0;
      border-radius: 0;
      background: none;
    }

    .toc details {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 0;
    }

    .toc summary {
      min-height: 0;
      padding: var(--space-2) 10px;
      color: var(--color-text-muted);
      font-size: 12px;
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      cursor: default;
      pointer-events: none;
    }

    .toc summary :global(.icon) {
      display: none;
    }

    /* 40 px — высота подписи «Содержание». */
    .toc ol {
      position: relative;
      max-height: calc(100dvh - 88px - var(--space-6) - 40px);
    }
  }

  @media (width >= 1280px) {
    .page {
      column-gap: var(--space-9);
    }
  }

  /* Только статьи с заметками резервируют правое поле. 240 + 24 + 680 + 48 + 208 = 1200 px.
     Текст сужается при нехватке места; широкие блоки используют освободившееся правое поле. */
  @media screen and (width >= 1280px) {
    .page:has(:global(.margin-note)) {
      grid-template-columns: 240px minmax(0, 1fr);
      column-gap: var(--space-6);
    }

    .page:has(:global(.margin-note)) .body {
      max-width: none;
    }

    .page:has(:global(.margin-note)) :is(.breadcrumbs, .head, .prerequisites, .related) {
      max-width: min(var(--content-width), 100% - 256px);
    }

    .page:has(:global(.margin-note)) .prose > :global(*) {
      width: calc(100% - 256px);
      box-sizing: border-box;
    }

    .page:has(:global(.margin-note)) .prose > :global(.margin-note-block) {
      width: 100%;
    }

    .page:has(:global(.margin-note)) .prose > :global(:is(figure, .data-table)) {
      width: min(var(--wide-width), 100%);
    }
  }

  @media print {
    .page:has(:global(.margin-note)) {
      grid-template-columns: minmax(0, 1fr);
    }

    .page:has(:global(.margin-note)) :is(.breadcrumbs, .head, .body) {
      grid-column: 1;
    }

    .page:has(:global(.margin-note)) .toc-cell {
      display: none;
    }
  }

  /* Тело статьи приходит из MDX без классов компонента. */
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .prose > :global(*) {
    margin: 0;
  }

  .prose > :global(p) {
    text-wrap: pretty;
  }

  .prose > :global(h2) {
    margin-top: var(--space-6);
  }

  .prose > :global(h3) {
    margin-top: var(--space-4);
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    scroll-margin-top: 88px;
  }

  /* Ссылка `#` видна при наведении на заголовок и при фокусе; на тач-экране без hover остаётся приглушённой. */
  .prose :global(.heading-link) {
    margin-inline-start: 0.4em;
    padding-inline: 0.2em;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 0.75em;
    font-weight: 400;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .prose :global(.heading-link::before) {
    content: '#';
  }

  .prose :global(:is(h2, h3, h4):hover .heading-link),
  .prose :global(.heading-link:focus-visible) {
    opacity: 1;
  }

  .prose :global(.heading-link:hover) {
    color: var(--color-link);
  }

  @media (hover: none) {
    .prose :global(.heading-link) {
      opacity: 0.6;
    }
  }

  /* Полоса прогресса: под шапкой, не занимает место в потоке; `top` задаёт скрипт по высоте шапки. */
  .progress {
    position: fixed;
    inset-inline: 0;
    top: 57px;
    z-index: var(--z-sticky);
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
    pointer-events: none;
  }

  .to-top {
    position: fixed;
    inset-block-end: var(--space-5);
    inset-inline-end: var(--space-4);
    z-index: var(--z-sticky);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: 14px;
    cursor: pointer;
  }

  .to-top[hidden] {
    display: none;
  }

  .to-top:hover {
    color: var(--color-accent-hover);
  }

  /* Смартфон: только стрелка, подпись остаётся для скринридера. */
  @media (width < 600px) {
    .to-top-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .copy-status {
    position: fixed;
    inset-block-end: var(--space-5);
    inset-inline: var(--space-4);
    z-index: var(--z-toast);
    width: fit-content;
    max-width: calc(100vw - 2 * var(--space-4));
    margin-inline: auto;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .copy-status[data-state='success'] {
    background: var(--color-success-bg);
    color: var(--color-success);
  }

  .copy-status[data-state='error'] {
    background: var(--color-surface-raised);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .prose > :global(ul),
  .prose > :global(ol) {
    padding-inline-start: 1.4em;
  }

  /* «Источники» — компактный раздел в конце: малый заголовок капителью и список 15 px. */
  .prose > :global(h2#sources) {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 13px;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .prose > :global(h2#sources ~ ul),
  .prose > :global(h2#sources ~ ol) {
    font-size: 15px;
    line-height: 1.5;
  }

  .prose > :global(h2#sources ~ ul > li + li),
  .prose > :global(h2#sources ~ ol > li + li) {
    margin-top: var(--space-2);
  }

  .prose :global(img),
  .prose :global(svg),
  .prose :global(table) {
    max-width: 100%;
  }
</style>
