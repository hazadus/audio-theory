---
// Общий каркас страницы: тема до CSS, ссылка перехода к содержимому, шапка и подвал (кроме графа).
// Страница выводит основное содержимое в <main id="content">.
// В <head> — описание, канонический адрес и Open Graph для поисковиков и превью ссылок;
// слот `head` добавляет страничные элементы, например микроразметку статьи.
import '@/styles/base.css';
import SearchDialog from '@/components/SearchDialog.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { analyticsConfig, siteConfig } from '@/site.config';
import { textAlignInitScript } from '@/lib/text-align';
import { themeInitScript } from '@/lib/theme';
import { feedPath, feedTitle } from '@/lib/updates-feed';
import { withBase } from '@/lib/urls';

interface Props {
  title: string;
  description?: string;
  /** Раздел сайта для активного пункта навигации (например, `materials` на странице статьи). */
  section?: string;
  /** Подвал; страница графа во всю высоту окна выводится без него. */
  footer?: boolean;
  /** Статья: `og:type` — `article`, даты в формате YYYY-MM-DD; у черновика дат нет. */
  article?: { published: string | null; modified?: string };
  /** Канонический адрес; 404.html отдаётся по любому неизвестному адресу, поэтому без него. */
  canonical?: boolean;
}

const { title, description, section, footer = true, article, canonical = true } = Astro.props;
// Главная называется именем сайта, остальные страницы получают его суффиксом.
const fullTitle = title === siteConfig.name ? title : `${title} — ${siteConfig.name}`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const image = {
  url: new URL(withBase(siteConfig.ogImage), Astro.site).href,
  width: 1200,
  height: 630,
  alt: `${siteConfig.name}: учебник по теории аудио и цифровой обработке звука`,
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={themeInitScript} />
    <script is:inline set:html={textAlignInitScript} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {description && <meta name="description" content={description} />}
    <title>{fullTitle}</title>
    {canonical && <link rel="canonical" href={pageUrl} />}
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={withBase('/icon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={image.url} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    {article?.published && <meta property="article:published_time" content={article.published} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="yandex-verification" content={siteConfig.verification.yandex} />
    <meta name="google-site-verification" content={siteConfig.verification.google} />
    <slot name="head" />
    <link rel="alternate" type="application/rss+xml" title={feedTitle} href={withBase(feedPath)} />
    <script
      defer
      src={`${analyticsConfig.host}/script.js`}
      data-website-id={analyticsConfig.websiteId}
      data-domains={analyticsConfig.domain}
    ></script>
    <script is:inline define:vars={{ analytics: analyticsConfig }}>
      // recorder.js не читает data-domains, поэтому подключается только на боевом домене.
      if (location.hostname === analytics.domain) {
        const recorder = document.createElement('script');
        recorder.defer = true;
        recorder.src = `${analytics.host}/recorder.js`;
        recorder.dataset.websiteId = analytics.websiteId;
        document.head.append(recorder);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content" data-pagefind-ignore>
      Перейти к содержимому
    </a>
    <SiteHeader {section} />
    <slot />
    {footer && <SiteFooter />}
    <SearchDialog />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    z-index: var(--z-modal);
    inset-inline-start: var(--space-4);
    top: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  /* Подвал прижат к низу окна на коротких страницах; отступ перед ним задаёт его margin-top. */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  main {
    flex: 1 0 auto;
    box-sizing: border-box;
    width: 100%;
    scroll-margin-top: 72px;
  }
</style>
