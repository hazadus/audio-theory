---
import Icon from '@/components/Icon.astro';
import RecentUpdates from '@/components/RecentUpdates.astro';
import TrackCard from '@/components/TrackCard.astro';
import VisualizationsSection from '@/components/VisualizationsSection.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { topics } from '@/data/topics';
import { loadArticleList } from '@/lib/article-list';
import { formatUpdatedDate } from '@/lib/format-date';
import { buildHomeGroups } from '@/lib/home';
import { loadTracks } from '@/lib/track-list';
import { loadVisualizationSection } from '@/lib/visualization-list';
import { materialsHref } from '@/lib/materials';
import { withBase } from '@/lib/urls';

const articles = await loadArticleList();
const groups = buildHomeGroups(articles, topics);
const introductions = [
  {
    slug: 'audio-intro',
    description:
      'Измените высоту и громкость, соберите ноту синтезатора и узнайте, как звук записывают в файл.',
  },
  {
    slug: 'music-theory-intro',
    description: 'Выберите ноты, соберите ритм и последовательность аккордов, попробуйте арпеджио.',
  },
  {
    slug: 'daw-intro',
    description: 'Познакомьтесь с музыкальной программой: дорожками, записью и первым проектом.',
  },
].flatMap((entry) => {
  const article = articles.find((article) => article.slug === entry.slug);
  return article ? [{ ...article, description: entry.description }] : [];
});
const tracks = await loadTracks();
const visualizations = await loadVisualizationSection();
---

<BaseLayout
  title="Теория аудио"
  description="Личный учебник по теории аудио и цифровой обработке звука."
>
  <main id="content" data-pagefind-body>
    <div class="hero">
      <h1>Теория аудио</h1>
      <p class="lead">
        Личный учебник по теории аудио и цифровой обработке звука: от звуковой волны до буферов в
        аудиопрограммах. Статьи самостоятельные, их можно читать в любом порядке.
      </p>
      <button type="button" class="search" data-search-open aria-keyshortcuts="/" hidden>
        <Icon name="search" size={20} />
        <span class="search-label">Найти статью или термин</span>
        <kbd aria-hidden="true">/</kbd>
      </button>
    </div>

    {tracks.length > 0 && (
      <section class="start" aria-labelledby="start-title" data-start-tracks data-pagefind-ignore>
        <div class="start-head">
          <h2 id="start-title">С чего начать</h2>
          <p>Треки: материалы сайта в порядке чтения под вашу задачу.</p>
        </div>
        <div class="start-overviews">
          {introductions.map((intro) => (
            <a class="start-intro" href={withBase(`/${intro.slug}/`)}>
              <div>
                <span class="start-intro-label">Первое знакомство</span>
                <b>{intro.title}</b>
                <p>{intro.description}</p>
              </div>
              <Icon name="arrow-right" size={22} />
            </a>
          ))}
        </div>
        <ul class="start-grid">
          {tracks.map((track) => (
            <li>
              <TrackCard {track} />
            </li>
          ))}
        </ul>
        <a class="all" href={withBase('/tracks/')}>
          Все треки
          <Icon name="chevron-right" size={14} />
        </a>
      </section>
    )}

    <VisualizationsSection section={visualizations} />

    <RecentUpdates />

    {groups.map((group) => (
      <section class="group" aria-labelledby={`group-${group.id}`}>
        <div class="group-head">
          <div class="group-title">
            <h2 id={`group-${group.id}`}>{group.title}</h2>
            <p>{group.description}</p>
          </div>
          <a class="all" href={withBase(materialsHref(group.id))}>
            Все {group.total}
            <Icon name="chevron-right" size={14} />
          </a>
        </div>
        <ul class="cards">
          {group.cards.map((card) => (
            <li>
              <a class="card" href={withBase(`/${card.slug}/`)}>
                <span class="card-title">{card.title}</span>
                <span class="card-question">{card.question}</span>
                <span class="card-meta">
                  {card.updated ? formatUpdatedDate(card.updated) : 'Черновик'} ·{' '}
                  {card.readingMinutes} мин
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  main {
    width: min(var(--container-max), 100% - 2 * var(--page-gutter));
    margin: 0 auto;
    padding-top: var(--space-9);
    padding-bottom: var(--space-10);
    font-family: var(--font-ui);
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 720px;
  }

  h1 {
    margin: 0;
    font-size: var(--text-4xl);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
  }

  .lead {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 560px;
    height: 48px;
    padding: 0 10px 0 16px;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    color: var(--color-text-muted);
    font: 400 1rem var(--font-ui);
    cursor: pointer;
  }

  .search[hidden] {
    display: none;
  }

  .search:focus-visible,
  .card:focus-visible {
    border-radius: var(--radius-lg);
  }

  .search:hover {
    border-color: var(--color-text-muted);
  }

  .search-label {
    flex: 1;
    text-align: start;
  }

  kbd {
    display: none;
    padding: 3px 6px;
    border: var(--border-width) solid var(--color-border);
    border-bottom-width: 2px;
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }

  .group-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 640px;
  }

  h2 {
    margin: 0;
    font-size: var(--text-2xl);
    line-height: 1.2;
    letter-spacing: var(--tracking-snug);
  }

  .group-title p {
    margin: 0;
    font-family: var(--font-text);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--color-link);
  }

  .start {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .start-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .start-head p {
    margin: 0;
    font-family: var(--font-text);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .start-overviews {
    display: grid;
    gap: var(--space-3);
  }
  .start-intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
  }
  .start-intro-label {
    display: block;
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .start-intro b {
    font-family: var(--font-text);
    font-size: var(--text-lg);
  }
  .start-intro p {
    margin: var(--space-2) 0 0;
    max-width: 680px;
    color: var(--color-text-muted);
  }
  .start-intro :global(svg) {
    flex: none;
    color: var(--color-link);
  }
  .start-intro:hover {
    border-color: var(--color-accent);
  }

  /* Одна колонка; 2 от 600 px, 3 от 1024 px. Ячейки фиксированной ширины: одиночная карточка не растягивается. */
  .start-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .start .all {
    align-self: flex-start;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    box-sizing: border-box;
    padding: 18px var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    color: var(--color-text);
    text-decoration: none;
  }

  .card:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface);
  }

  .card-title {
    font-family: var(--font-text);
    font-weight: 600;
    font-size: 1.1875rem;
    line-height: 1.25;
    text-wrap: balance;
  }

  .card-question {
    font-family: var(--font-text);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .card-meta {
    margin-top: auto;
    padding-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (width >= 600px) {
    .start-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 1024px) {
    .start-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    kbd {
      display: block;
    }
  }

  @media (width < 640px) {
    main {
      padding-top: var(--space-8);
      gap: var(--space-8);
    }

    h1 {
      font-size: var(--text-3xl);
    }
  }
</style>
