---
import '@/styles/base.css';
import Icon from '@/components/Icon.astro';
import { siteConfig } from '@/site.config';
import { withBase } from '@/lib/urls';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Личный учебник по теории аудио и цифровой обработке звука." />
    <title>Теория аудио</title>
  </head>
  <body>
    <main id="top" data-pagefind-body>
      <h1>Теория аудио</h1>
      <p>Личный учебник по теории аудио и цифровой обработке звука.</p>
      <p class="status">Сайт в разработке. Материалы появятся позже.</p>
      <p data-pagefind-ignore>
        <a href={withBase('/')}>На главную</a> ·{' '}
        <a class="external" href={siteConfig.repository}>
          GitHub
          <Icon name="external-link" size={16} />
        </a>
      </p>
    </main>
  </body>
</html>

<style>
  main {
    max-width: var(--content-width);
    margin: var(--space-9) auto;
    padding-inline: var(--page-gutter);
  }

  h1 {
    margin: 0 0 var(--space-6);
  }

  p {
    margin: 0 0 var(--space-6);
  }

  .status {
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    line-height: var(--leading-normal);
  }

  .external {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-link-external);
  }
</style>
