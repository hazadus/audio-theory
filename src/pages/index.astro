---
import Icon from '@/components/Icon.astro';
import RecentUpdates from '@/components/RecentUpdates.astro';
import VisualizationsSection from '@/components/VisualizationsSection.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { topics } from '@/data/topics';
import { loadArticleList } from '@/lib/article-list';
import { formatUpdatedDate } from '@/lib/format-date';
import { buildHomeGroups } from '@/lib/home';
import { loadVisualizationSection } from '@/lib/visualization-list';
import { materialsHref } from '@/lib/materials';
import { withBase } from '@/lib/urls';

const groups = buildHomeGroups(await loadArticleList(), topics);
const visualizations = await loadVisualizationSection();
---

<BaseLayout
  title="Теория аудио"
  description="Личный учебник по теории аудио и цифровой обработке звука."
>
  <main id="content" data-pagefind-body>
    <div class="hero">
      <h1>Теория аудио</h1>
      <p class="lead">
        Личный учебник по теории аудио и цифровой обработке звука: от звуковой волны до буферов в
        аудиопрограммах. Статьи самостоятельные, их можно читать в любом порядке.
      </p>
      <button type="button" class="search" data-search-open aria-keyshortcuts="/" hidden>
        <Icon name="search" size={20} />
        <span class="search-label">Найти статью или термин</span>
        <kbd aria-hidden="true">/</kbd>
      </button>
    </div>

    <VisualizationsSection section={visualizations} />

    <RecentUpdates />

    {groups.map((group) => (
      <section class="group" aria-labelledby={`group-${group.id}`}>
        <div class="group-head">
          <div class="group-title">
            <h2 id={`group-${group.id}`}>{group.title}</h2>
            <p>{group.description}</p>
          </div>
          <a class="all" href={withBase(materialsHref(group.id))}>
            Все {group.total}
            <Icon name="chevron-right" size={14} />
          </a>
        </div>
        <ul class="cards">
          {group.cards.map((card) => (
            <li>
              <a class="card" href={withBase(`/${card.slug}/`)}>
                <span class="card-title">{card.title}</span>
                <span class="card-question">{card.question}</span>
                <span class="card-meta">
                  {card.updated ? formatUpdatedDate(card.updated) : 'Черновик'} ·{' '}
                  {card.readingMinutes} мин
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  main {
    width: min(var(--container-max), 100% - 2 * var(--page-gutter));
    margin: 0 auto;
    padding-top: var(--space-9);
    padding-bottom: var(--space-10);
    font-family: var(--font-ui);
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 720px;
  }

  h1 {
    margin: 0;
    font-size: var(--text-4xl);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
  }

  .lead {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 560px;
    height: 48px;
    padding: 0 10px 0 16px;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    color: var(--color-text-muted);
    font: 400 1rem var(--font-ui);
    cursor: pointer;
  }

  .search[hidden] {
    display: none;
  }

  .search:focus-visible,
  .card:focus-visible {
    border-radius: var(--radius-lg);
  }

  .search:hover {
    border-color: var(--color-text-muted);
  }

  .search-label {
    flex: 1;
    text-align: start;
  }

  kbd {
    display: none;
    padding: 3px 6px;
    border: var(--border-width) solid var(--color-border);
    border-bottom-width: 2px;
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }

  .group-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 640px;
  }

  h2 {
    margin: 0;
    font-size: var(--text-2xl);
    line-height: 1.2;
    letter-spacing: var(--tracking-snug);
  }

  .group-title p {
    margin: 0;
    font-family: var(--font-text);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--color-link);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    box-sizing: border-box;
    padding: 18px var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    color: var(--color-text);
    text-decoration: none;
  }

  .card:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface);
  }

  .card-title {
    font-family: var(--font-text);
    font-weight: 600;
    font-size: 1.1875rem;
    line-height: 1.25;
    text-wrap: balance;
  }

  .card-question {
    font-family: var(--font-text);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .card-meta {
    margin-top: auto;
    padding-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (width >= 1024px) {
    kbd {
      display: block;
    }
  }

  @media (width < 640px) {
    main {
      padding-top: var(--space-8);
      gap: var(--space-8);
    }

    h1 {
      font-size: var(--text-3xl);
    }
  }
</style>
