---
// Все теги: А–Я по буквам, как в глоссарии, или по числу статей. Без JS остаётся порядок А–Я.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tags } from '@/data/tags';
import { loadArticleList } from '@/lib/article-list';
import { compareTagCounts, countTags, groupTags, tagHref, tagsLabel } from '@/lib/tags';
import { withBase } from '@/lib/urls';

const counted = countTags(await loadArticleList(), tags);
const groups = groupTags(counted);
const byCount = [...counted].sort(compareTagCounts);
const lead = `${tagsLabel(counted.length)}. У статьи может быть несколько тегов.`;
const sorts = [
  { id: 'alpha', label: 'А–Я' },
  { id: 'count', label: 'По числу статей' },
];
---

<BaseLayout title="Теги" description="Все теги статей учебника с числом статей у каждого.">
  <main id="content" data-pagefind-ignore data-tags>
    <header class="head">
      <h1>Теги</h1>
      <p class="lead">{counted.length > 0 ? lead : 'Тегов пока нет.'}</p>
    </header>

    {counted.length > 0 && (
      <>
        <div class="toolbar">
          <nav class="letters" aria-label="Буквы" data-tag-letters>
            {groups.map((group) => (
              <a href={`#${group.id}`}>{group.letter}</a>
            ))}
          </nav>
          <div class="segments" role="radiogroup" aria-label="Порядок" data-tag-sorts hidden>
            {sorts.map((sort) => (
              <button
                type="button"
                role="radio"
                class="segment"
                data-tag-sort={sort.id}
                aria-checked={sort.id === 'alpha' ? 'true' : 'false'}
                tabindex={sort.id === 'alpha' ? 0 : -1}
              >
                {sort.label}
              </button>
            ))}
          </div>
        </div>

        <div class="columns" data-tag-view="alpha">
          {groups.map((group) => (
            <section aria-labelledby={group.id}>
              <h2 id={group.id}>{group.letter}</h2>
              <ul class="rows">
                {group.tags.map((tag) => (
                  <li>
                    <a class="row" href={withBase(tagHref(tag.id))}>
                      <span class="name">
                        <span class="hash" aria-hidden="true">
                          #
                        </span>
                        {tag.title}
                      </span>
                      <span class="count">{tag.count}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>

        <div class="columns" data-tag-view="count" hidden>
          <ul class="rows">
            {byCount.map((tag) => (
              <li>
                <a class="row" href={withBase(tagHref(tag.id))}>
                  <span class="name">
                    <span class="hash" aria-hidden="true">
                      #
                    </span>
                    {tag.title}
                  </span>
                  <span class="count">{tag.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </>
    )}
  </main>
</BaseLayout>

<script>
  import { initTags } from '@/lib/tags-controller';

  initTags();
</script>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: min(var(--container-max), 100% - 2 * var(--page-gutter));
    margin: 0 auto;
    padding-top: 28px;
    padding-bottom: var(--space-10);
    font-family: var(--font-ui);
  }

  @media (width >= 600px) {
    main {
      padding-top: 56px;
    }
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 720px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--text-4xl);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
  }

  .lead {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-text);
    font-size: var(--text-lg);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
  }

  .letters {
    display: flex;
    gap: 2px;
    max-width: calc(100% + 2 * var(--page-gutter));
    /* На смартфоне ряд букв прокручивается до края экрана. */
    margin-inline: calc(-1 * var(--page-gutter));
    padding-inline: var(--page-gutter);
    overflow-x: auto;
  }

  @media (width >= 600px) {
    .letters {
      max-width: 100%;
      margin-inline: 0;
      padding-inline: 0;
    }
  }

  .letters[hidden],
  .segments[hidden],
  .columns[hidden] {
    display: none;
  }

  .letters a {
    display: grid;
    flex: none;
    place-items: center;
    min-width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .letters a:hover {
    background: var(--color-surface);
  }

  .segments {
    display: flex;
    gap: 2px;
    padding: 3px;
    border: var(--border-width) solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
  }

  .segment {
    min-height: 36px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-muted);
    font: 500 0.875rem var(--font-ui);
    white-space: nowrap;
    cursor: pointer;
  }

  .segment[aria-checked='true'] {
    background: var(--color-bg);
    box-shadow: 0 0 0 1px var(--color-border);
    color: var(--color-text);
    font-weight: 600;
  }

  .columns {
    column-gap: 40px;
    columns: 1;
  }

  @media (width >= 600px) {
    .columns {
      columns: 2;
    }
  }

  @media (width >= 1024px) {
    .columns {
      columns: 3;
    }
  }

  section {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-6);
    break-inside: avoid;
  }

  h2 {
    margin: 0 0 6px;
    padding-bottom: 6px;
    border-bottom: var(--border-width) solid var(--color-border);
    font-family: var(--font-text);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.3;
    scroll-margin-top: 72px;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rows li {
    break-inside: avoid;
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 44px;
    border-bottom: var(--border-width) solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
  }

  .row:hover {
    color: var(--color-accent);
  }

  .name {
    font-size: 16px;
    font-weight: 500;
  }

  .hash {
    margin-right: 2px;
    color: var(--color-text-muted);
  }

  .count {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 13px;
  }
</style>
