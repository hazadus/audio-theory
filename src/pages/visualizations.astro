---
// Все интерактивные визуализации: те же карточки, что на главной, без ограничения числа.
// Главная показывает четыре карточки и ссылку «Все N» сюда. Без `data-pagefind-body`: карточки
// уже есть в индексе главной, как список материалов повторял бы статьи.
import VisualizationCard from '@/components/VisualizationCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadVisualizationSection } from '@/lib/visualization-list';

const { cards } = await loadVisualizationSection(Infinity);
---

<BaseLayout
  title="Интерактивные визуализации"
  description="Все интерактивные визуализации учебника: графики и звук, параметры которых можно менять."
>
  <main id="content">
    <div class="head">
      <h1>Интерактивные визуализации</h1>
      <p class="lead">
        Графики и звук, параметры которых можно менять. Карточка открывает визуализацию в статье,
        рядом с объяснением.
      </p>
    </div>
    <ul class="viz-list">
      {cards.map((card) => (
        <li>
          <VisualizationCard card={card} />
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>

<style>
  main {
    width: min(var(--container-max), 100% - 2 * var(--page-gutter));
    margin: 0 auto;
    padding-top: var(--space-9);
    padding-bottom: var(--space-10);
    font-family: var(--font-ui);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 720px;
  }

  h1 {
    margin: 0;
    font-size: var(--text-4xl);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
  }

  .lead {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* Как на главной, но без ленты: на смартфоне карточки идут в одну колонку. */
  .viz-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 600px) {
    .viz-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 1024px) {
    .viz-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (width < 640px) {
    main {
      padding-top: var(--space-8);
    }

    h1 {
      font-size: var(--text-3xl);
    }
  }
</style>
