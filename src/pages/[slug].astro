---
import { getCollection, render } from 'astro:content';
import { assertValidArticles } from '@/lib/article-content';
import { loadUpdates } from '@/lib/update-list';
import { assertUniqueSlugs } from '@/lib/articles';
import { assertUniqueAnchors, getToc } from '@/lib/headings';
import { resolveArticleDates } from '@/lib/article-dates';
import { allowDraftEnv, getPublishedDate } from '@/lib/git-date';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { resolveReadingMinutes } from '@/lib/reading-time';
import { loadTrackData } from '@/lib/track-data';
import { getArticleTracks } from '@/lib/tracks';
import { buildNavData } from '@/lib/track-navigation';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  await loadUpdates();
  assertUniqueSlugs(articles);
  // Источники, ссылки, листинги и нумерация проверяются по всей коллекции до генерации страниц.
  assertValidArticles(
    await Promise.all(
      articles.map(async (article) => ({
        id: article.id,
        body: article.body ?? '',
        data: article.data,
        headings: (await render(article)).headings,
      })),
    ),
  );
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
assertUniqueAnchors(headings, article.id);
const toc = getToc(headings);
const readingMinutes = resolveReadingMinutes(article.body ?? '', article.data.readingMinutes);
// Dev-сервер и сборка с ALLOW_DRAFT_ARTICLES=1 показывают «Черновик» для файла без коммита; иначе это ошибка.
const dates = resolveArticleDates(
  getPublishedDate(article.filePath!, {
    allowDraft: import.meta.env.DEV || process.env[allowDraftEnv] === '1',
  }),
  (await loadUpdates()).filter(({ article: slug }) => slug === article.data.slug),
);
const tracks = await loadTrackData();
const articleTracks = getArticleTracks(tracks, article.data.slug);
const trackNav = buildNavData(tracks, article.data.slug);
---

<ArticleLayout data={article.data} {toc} {dates} {readingMinutes} {articleTracks} {trackNav}>
  <Content />
</ArticleLayout>
