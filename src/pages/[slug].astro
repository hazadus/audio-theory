---
import { getCollection, render } from 'astro:content';
import { assertValidArticles } from '@/lib/article-content';
import { seriesPosition } from '@/lib/first-steps';
import { loadFirstSteps } from '@/lib/first-steps-list';
import { loadUpdates } from '@/lib/update-list';
import { assertUniqueSlugs } from '@/lib/articles';
import { assertUniqueAnchors, getToc } from '@/lib/headings';
import { resolveArticleDates } from '@/lib/article-dates';
import { allowDraftEnv, getPublishedDate } from '@/lib/git-date';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { resolveReadingMinutes } from '@/lib/reading-time';
import { loadTrackData } from '@/lib/track-data';
import { getArticleTracks } from '@/lib/tracks';
import { buildNavData } from '@/lib/track-navigation';
import { localGraph, minLocalLinks, neighborsOf } from '@/lib/graph';
import { loadGraph } from '@/lib/graph-data';
import { withBase } from '@/lib/urls';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  await loadUpdates();
  assertUniqueSlugs(articles);
  // Источники, ссылки, листинги и нумерация проверяются по всей коллекции до генерации страниц.
  assertValidArticles(
    await Promise.all(
      articles.map(async (article) => ({
        id: article.id,
        body: article.body ?? '',
        data: article.data,
        headings: (await render(article)).headings,
      })),
    ),
  );
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
assertUniqueAnchors(headings, article.id);
const toc = getToc(headings);
const readingMinutes = resolveReadingMinutes(article.body ?? '', article.data.readingMinutes);
// Dev-сервер и сборка с ALLOW_DRAFT_ARTICLES=1 показывают «Черновик» для файла без коммита; иначе это ошибка.
const gitPublished = getPublishedDate(article.filePath!, {
  allowDraft: import.meta.env.DEV || process.env[allowDraftEnv] === '1',
});
const dates = resolveArticleDates(
  gitPublished,
  (await loadUpdates()).filter(({ article: slug }) => slug === article.data.slug),
  { isDraft: gitPublished === null },
);
const tracks = await loadTrackData();
const articleTracks = getArticleTracks(tracks, article.data.slug);
const trackNav = buildNavData(tracks, article.data.slug);
const series = seriesPosition(await loadFirstSteps(), article.data.slug);
const graphData = await loadGraph();
const articleHref = (slug: string) => withBase(`/${slug}/`);
const graphArticle = graphData.articles.find(({ slug }) => slug === article.data.slug)!;
const titleOf = (slug: string) => graphData.articles.find((item) => item.slug === slug)!.title;
// Блок «Связи» выводится, если у статьи не меньше трёх соседей.
const graph =
  neighborsOf(graphData, article.data.slug).length >= minLocalLinks
    ? {
        local: localGraph(graphData, article.data.slug, articleHref),
        outs: graphArticle.out.map((slug) => ({ title: titleOf(slug), href: articleHref(slug) })),
        ins: graphArticle.in.map((slug) => ({ title: titleOf(slug), href: articleHref(slug) })),
      }
    : null;
---

<ArticleLayout
  data={article.data}
  {toc}
  {dates}
  {readingMinutes}
  {articleTracks}
  {trackNav}
  {series}
  {graph}
>
  <Content />
</ArticleLayout>
