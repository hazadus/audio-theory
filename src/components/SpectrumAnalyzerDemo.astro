---
// «Анализатор спектра»: спектр одного кадра или среднее 16 кадров шума на логарифмической оси
// частот, размер кадра, окно, шкала и прослушивание той же петли. Начальный рисунок и подпись
// создаются при сборке; без JavaScript, во время загрузки и при ошибке параметры неактивны.
import Icon from '@/components/Icon.astro';
import { demoCaptions } from '@/lib/demo-captions';
import { initialVolume } from '@/lib/sampling-audio';
import { volumeStep, volumeText } from '@/lib/sampling-player';
import {
  analyzerSignals,
  averageFrames,
  defaultAnalyzer,
  frameSizes,
  levelScales,
  renderAnalyzer,
  toneSteps,
  windowKinds,
} from '@/lib/spectrum';
import {
  analyzerCaption,
  analyzerStatus,
  analyzerSvg,
  signalNames,
  sizeText,
  toneText,
  windowNames,
} from '@/lib/spectrum-view';
import '@/styles/spectrum.css';

interface Props {
  /** Номер рисунка: визуализации и рисунки нумеруются одной последовательностью. */
  figure: number;
  /** Якорь для ссылок `#id`; английский kebab-case. */
  id?: string;
}

const { figure, id = demoCaptions.SpectrumAnalyzerDemo.defaultId } = Astro.props;
const p = defaultAnalyzer;
const render = renderAnalyzer(p);
const status = analyzerStatus(render);
const scaleNames = { db: 'дБ', linear: 'линейная' };
---

<figure
  id={id}
  class="spectrum-demo"
  aria-labelledby={`${id}-name`}
  data-spectrum-analyzer
  data-state="static"
>
  <div class="spectrum-demo-head">
    <span class="spectrum-demo-label">Визуализация {figure}</span>
    <span class="spectrum-demo-name" id={`${id}-name`}>
      {demoCaptions.SpectrumAnalyzerDemo.name}
    </span>
  </div>
  <div
    class="spectrum-demo-chart"
    role="region"
    aria-label="График спектра кадра"
    tabindex="0"
    data-chart
    set:html={analyzerSvg(render, id)}
  />
  <ul class="spectrum-demo-legend" aria-label="Легенда">
    <li>
      <i class="spectrum"></i>уровни бинов, точки — отдельные бины
    </li>
    <li>
      <i class="mark"></i>частота тона
    </li>
  </ul>
  <div class="spectrum-demo-status">
    {status.map((line) => (
      <p data-status-line>{line}</p>
    ))}
  </div>
  <p class="visually-hidden" aria-live="polite" data-announce></p>
  <fieldset class="spectrum-demo-controls" data-controls disabled>
    <legend class="visually-hidden">Сигнал и параметры анализа</legend>
    <div class="spectrum-demo-grid">
      <div class="spectrum-demo-param">
        <div class="spectrum-demo-select">
          <label for={`${id}-signal`}>Сигнал</label>
          <select id={`${id}-signal`} data-select="signal">
            {analyzerSignals.map((signal) => (
              <option value={signal} selected={signal === p.signal}>
                {signalNames[signal]}
              </option>
            ))}
          </select>
        </div>
        <div class="spectrum-demo-param-head">
          <label for={`${id}-tone`}>Частота тона</label>
          <output for={`${id}-tone`} data-output="tone">
            {toneText(p.toneStep)}
          </output>
        </div>
        <input
          id={`${id}-tone`}
          class="spectrum-demo-range"
          type="range"
          min="0"
          max={toneSteps.length - 1}
          step="1"
          value={p.toneStep}
          aria-valuetext={toneText(p.toneStep)}
          data-range="tone"
        />
        <p class="spectrum-demo-tone-note" data-tone-note hidden>
          У этого сигнала частота задана заранее.
        </p>
      </div>
      <div class="spectrum-demo-param">
        <div class="spectrum-demo-select">
          <label for={`${id}-size`}>Размер кадра N</label>
          <select id={`${id}-size`} data-select="size">
            {frameSizes.map((_, index) => (
              <option value={index} selected={index === p.sizeIndex}>
                {sizeText(index)}
              </option>
            ))}
          </select>
        </div>
        <fieldset class="spectrum-demo-choice">
          <legend>Окно:</legend>
          {windowKinds.map((kind) => (
            <label class="spectrum-demo-option">
              <input
                type="radio"
                name={`${id}-window`}
                value={kind}
                checked={kind === p.window}
                data-window
              />
              {windowNames[kind]}
            </label>
          ))}
        </fieldset>
        <fieldset class="spectrum-demo-choice">
          <legend>Шкала:</legend>
          {levelScales.map((scale) => (
            <label class="spectrum-demo-option">
              <input
                type="radio"
                name={`${id}-scale`}
                value={scale}
                checked={scale === p.scale}
                data-scale
              />
              {scaleNames[scale]}
            </label>
          ))}
        </fieldset>
        <label class="spectrum-demo-option">
          <input type="checkbox" checked={p.average} disabled data-average />
          Усреднить {averageFrames} кадров шума
        </label>
      </div>
    </div>
    <div class="spectrum-demo-actions">
      <span></span>
      <button type="button" class="spectrum-demo-reset" data-reset>
        <Icon name="rotate-ccw" size={16} />
        Сбросить
      </button>
    </div>
    <div class="spectrum-demo-audio">
      <p class="spectrum-demo-warning" role="note">
        <Icon name="volume-2" size={18} />
        <span>
          <b>Громкость.</b> Чистый тон, пила и белый шум звучат резко: перед запуском убавьте
          громкость, особенно в наушниках.
        </span>
      </p>
      <div
        class="spectrum-demo-player"
        role="group"
        aria-label="Аудиопример: анализируемый сигнал"
        data-player-group
        data-mode="ready"
      >
        <button type="button" class="spectrum-demo-play" aria-label="Воспроизвести" data-play>
          <span class="spectrum-demo-play-icon start">
            <Icon name="play" size={18} />
          </span>
          <span class="spectrum-demo-play-icon stop">
            <Icon name="square" size={16} />
          </span>
        </button>
        <div class="spectrum-demo-volume">
          <button type="button" class="spectrum-demo-mute" aria-label="Выключить звук" data-mute>
            <span class="spectrum-demo-mute-icon on">
              <Icon name="volume-2" size={18} />
            </span>
            <span class="spectrum-demo-mute-icon off">
              <Icon name="volume-x" size={18} />
            </span>
          </button>
          <input
            class="spectrum-demo-range compact"
            type="range"
            min="0"
            max="100"
            step={volumeStep}
            value={initialVolume * 100}
            aria-label="Громкость"
            aria-valuetext={volumeText(initialVolume * 100)}
            data-volume
          />
          <span class="spectrum-demo-volume-text" data-volume-text>
            {volumeText(initialVolume * 100)}
          </span>
        </div>
      </div>
      <p class="spectrum-demo-player-state" role="status" data-player-state>
        Остановлен
      </p>
    </div>
    <p class="spectrum-demo-note-text" data-controls-note>
      Параметры и звук работают с включённым JavaScript. Показано начальное состояние.
    </p>
  </fieldset>
  <figcaption class="spectrum-demo-caption">
    <b>Рис. {figure}.</b> <span data-caption>{analyzerCaption(render)}</span>
  </figcaption>
</figure>

<script>
  import { initAnalyzerDemos } from '@/lib/spectrum-controller';

  initAnalyzerDemos();
</script>
