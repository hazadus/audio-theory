---
// Журнал обновлений за один год: общая страница для /updates/ и /updates/YYYY/.
// Без JS видны все записи года; фильтр типа появляется после подключения скрипта.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadUpdates } from '@/lib/update-list';
import {
  currentYear,
  earlierYears,
  groupByDay,
  typeFilters,
  typeLabels,
  updateMeta,
  updateYears,
} from '@/lib/update-view';
import { withBase } from '@/lib/urls';

interface Props {
  /** Год архива; без него показывается последний непустой год. */
  year?: string;
}

const entries = await loadUpdates();
const years = updateYears(entries);
const year = Astro.props.year ?? currentYear(entries);
const archive = Astro.props.year !== undefined;
const days = year ? groupByDay(entries, year) : [];
const earlier = year ? earlierYears(years, year) : [];
const title = archive ? `Обновления за ${year} год` : 'Обновления';
const intro =
  'Новые материалы и дополнения к опубликованным, по датам. Ссылки ведут прямо к изменённому месту.';
---

<BaseLayout {title} description={intro}>
  <main id="content" data-updates data-year={year} data-pagefind-ignore>
    <header class="head">
      <h1>{title}</h1>
      {year && !archive && <p class="year">{year} год</p>}
      <p class="intro">{intro}</p>
      {archive && (
        <a class="latest" href={withBase('/updates/')}>
          Последние обновления
        </a>
      )}
      {year && (
        <div class="controls" data-controls hidden>
          <div class="filter" role="group" aria-label="Тип изменений">
            {typeFilters.map((filter) => (
              <button
                type="button"
                class="segment"
                data-type-filter={filter.id}
                aria-pressed={filter.id === 'all' ? 'true' : 'false'}
              >
                {filter.label}
              </button>
            ))}
          </div>
        </div>
      )}
    </header>

    {!year && <p class="none">Обновлений пока нет</p>}

    {year && (
      <p class="none" data-empty role="status" hidden>
        Нет обновлений этого типа за {year}
      </p>
    )}

    {days.length > 0 && (
      <div class="days">
        {days.map((day) => (
          <section class="day" data-day aria-labelledby={day.date}>
            <h2 id={day.date}>
              <time datetime={day.date}>{day.label}</time>
            </h2>
            <div class="entries">
              {day.entries.map((entry) => (
                <article class="entry" id={`update-${entry.id}`} data-entry data-type={entry.type}>
                  <div class="line">
                    <span class:list={['badge', entry.type]}>{typeLabels[entry.type]}</span>
                    <a class="title" href={entry.href}>
                      {entry.title}
                    </a>
                  </div>
                  {entry.type === 'new' && entry.summary && <p class="summary">{entry.summary}</p>}
                  {entry.items.length > 0 && (
                    <ul>
                      {entry.items.map((item) => (
                        <li>
                          <a href={item.href}>{item.text}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                  <span class="meta">{updateMeta(entry)}</span>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    )}

    {earlier.length > 0 && (
      <nav class="archive" aria-label="Архив обновлений">
        <span>Ранее:</span>
        {earlier.map((item) => (
          <a href={withBase(`/updates/${item}/`)}>{item}</a>
        ))}
      </nav>
    )}
  </main>
</BaseLayout>

<script>
  import { initUpdates } from '@/lib/updates-controller';

  initUpdates();
</script>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    width: min(var(--container-max), 100% - 2 * var(--page-gutter));
    margin: 0 auto;
    padding-top: var(--space-8);
    padding-bottom: var(--space-10);
    font-family: var(--font-ui);
  }

  .days,
  .archive {
    max-width: 960px;
  }

  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    max-width: 720px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--text-4xl);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .year {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-ui);
    font-weight: 600;
  }

  .intro {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-text);
    font-size: var(--text-lg);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .latest,
  .archive a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
  }

  .controls[hidden] {
    display: none;
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    max-width: 100%;
    gap: 2px;
    padding: 3px;
    border: var(--border-width) solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
  }

  .segment {
    min-height: 38px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-muted);
    font: 500 var(--text-sm) var(--font-ui);
    white-space: nowrap;
    cursor: pointer;
  }

  .segment[aria-pressed='true'] {
    background: var(--color-bg);
    box-shadow: 0 0 0 1px var(--color-border);
    color: var(--color-text);
    font-weight: 600;
  }

  .none {
    margin: 0;
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .none[hidden] {
    display: none;
  }

  .days {
    display: flex;
    flex-direction: column;
  }

  .day {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    padding: var(--space-6) 0 28px;
    border-top: var(--border-width) solid var(--color-border);
  }

  .day[hidden] {
    display: none;
  }

  .day h2 {
    margin: 0;
    padding-top: 2px;
    scroll-margin-top: 72px;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    font-weight: 600;
    line-height: 1.5;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
  }

  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    scroll-margin-top: 72px;
  }

  .entry[hidden] {
    display: none;
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
  }

  .badge {
    position: relative;
    top: -2px;
    padding: 4px 7px;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .badge.new {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .badge.updated {
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
    color: var(--color-text-muted);
  }

  .title {
    min-width: 0;
    color: var(--color-text);
    font-family: var(--font-text);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
    text-decoration: none;
    text-wrap: balance;
  }

  .title:hover {
    text-decoration: underline;
  }

  .summary {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--text-base);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0 0 0 20px;
    font-family: var(--font-text);
    font-size: var(--text-base);
    line-height: 1.55;
  }

  li {
    padding-left: 2px;
    overflow-wrap: anywhere;
  }

  .meta {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .archive {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (width >= 600px) {
    .day {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: var(--space-7);
    }
  }
</style>
