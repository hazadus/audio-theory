---
// Карточка визуализации: одна ссылка на якорь в статье — превью, название, что можно менять,
// статья-источник и метка «Со звуком». Используется на главной и на странице `/visualizations/`.
import Icon from '@/components/Icon.astro';
import VisualizationPreview from '@/components/VisualizationPreview.astro';
import { withBase } from '@/lib/urls';
import type { VisualizationCard } from '@/lib/visualizations';

interface Props {
  card: VisualizationCard;
}

const { card } = Astro.props;
---

<a class="viz-card" href={withBase(card.href)}>
  <VisualizationPreview kind={card.preview} />
  <span class="viz-body">
    <span class="viz-title">{card.name}</span>
    <span class="viz-what">{card.what}</span>
    <span class="viz-meta">
      <span class="viz-source">Из статьи «{card.articleTitle}»</span>
      {card.sound && (
        <span class="viz-sound">
          <Icon name="volume-2" size={15} />
          Со звуком
        </span>
      )}
    </span>
  </span>
</a>

<style>
  .viz-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    color: var(--color-text);
    text-decoration: none;
  }

  .viz-card:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface);
  }

  .viz-card:focus-visible {
    border-radius: var(--radius-lg);
  }

  .viz-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: 14px var(--space-4) var(--space-4);
  }

  .viz-title {
    font-family: var(--font-text);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.25;
    text-wrap: balance;
  }

  .viz-what {
    font-family: var(--font-text);
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .viz-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    margin-top: auto;
    padding-top: 6px;
    font-size: var(--text-xs);
    line-height: 1.35;
    color: var(--color-text-muted);
  }

  .viz-source {
    flex: 1 1 140px;
  }

  .viz-sound {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    white-space: nowrap;
  }
</style>
