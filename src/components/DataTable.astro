---
// Таблица данных: `<caption>` «Таблица N.» сверху, заголовки со `scope`, числа справа, прокрутка внутри блока.
// Заголовки и ячейки — доверенный HTML автора (`<i>`, `<sub>`); первый столбец — заголовки строк, он закреплён.
interface Column {
  label: string;
  /** `end` — числа: выравнивание вправо и табличные цифры. */
  align?: 'start' | 'end';
}

interface Props {
  /** Английский kebab-case; якорь для ссылок `#id`. */
  id: string;
  /** Номер таблицы в статье (последовательность 1, 2, 3…). */
  number: number;
  /** Видимая подпись без префикса «Таблица N.». */
  caption: string;
  columns: Column[];
  rows: (string | number)[][];
}

const { id, number, caption, columns, rows } = Astro.props;
if (columns.length === 0 || rows.length === 0) {
  throw new Error(`DataTable «${id}»: нужны столбцы и строки`);
}
for (const [index, row] of rows.entries()) {
  if (row.length !== columns.length) {
    throw new Error(
      `DataTable «${id}»: в строке ${index + 1} ${row.length} ячеек вместо ${columns.length}`,
    );
  }
}
---

<div class="data-table" id={id}>
  <div class="data-table-frame" data-table-frame>
    <div
      class="data-table-scroll"
      data-table-scroll
      role="region"
      aria-labelledby={`${id}-caption`}
      tabindex="0"
    >
      <table>
        <caption id={`${id}-caption`}>
          <span class="data-table-caption">
            <b>Таблица {number}.</b> {caption}
          </span>
        </caption>
        <thead>
          <tr>
            {columns.map((column) => (
              <th scope="col" data-align={column.align ?? 'start'} set:html={column.label} />
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              {row.map((cell, index) =>
                index === 0 ? (
                  <th
                    scope="row"
                    data-align={columns[0].align ?? 'start'}
                    set:html={String(cell)}
                  />
                ) : (
                  <td data-align={columns[index].align ?? 'start'} set:html={String(cell)} />
                ),
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  import { initDataTables } from '@/lib/data-table-controller';

  initDataTables();
</script>

<style is:global>
  .data-table {
    margin-block: var(--space-6);
    scroll-margin-top: 88px;
  }

  .data-table-frame {
    position: relative;
  }

  /* Тени по краям: показывают, что справа или слева есть непрокрученные столбцы. */
  .data-table-frame::before,
  .data-table-frame::after {
    content: '';
    position: absolute;
    top: var(--shadow-top, 0);
    bottom: 0;
    width: 24px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .data-table-frame::before {
    left: calc(var(--shadow-left, 0px) + var(--border-width));
    z-index: 3;
    background: linear-gradient(to right, var(--color-border), transparent);
  }

  .data-table-frame::after {
    right: 0;
    z-index: 3;
    background: linear-gradient(to left, var(--color-border), transparent);
  }

  .data-table-frame[data-more-start]::before,
  .data-table-frame[data-more-end]::after {
    opacity: 1;
  }

  .data-table-scroll {
    container-type: inline-size;
    overflow-x: auto;
    border-radius: var(--radius-md);
  }

  .data-table-scroll:focus-visible {
    box-shadow: var(--focus-ring);
    outline: none;
  }

  .data-table table {
    width: 100%;
    min-width: 460px;
    border-collapse: separate;
    border-spacing: 0;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }

  /* Подпись остаётся в видимой части блока, пока таблица прокручивается. */
  .data-table caption {
    padding: 0 0 10px;
    text-align: start;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .data-table-caption {
    position: sticky;
    left: 0;
    display: block;
    max-width: 100cqw;
  }

  .data-table-caption b {
    font-weight: 600;
    color: var(--color-text);
  }

  .data-table th,
  .data-table td {
    padding: 10px 14px;
    border-bottom: var(--border-width) solid var(--color-border);
    text-align: start;
    vertical-align: top;
  }

  .data-table tbody tr:last-child > * {
    border-bottom: 0;
  }

  .data-table thead th {
    background: var(--color-surface);
    font-weight: 600;
  }

  .data-table [data-align='end'] {
    text-align: end;
  }

  .data-table td {
    color: var(--color-text);
  }

  .data-table td:not([data-align='end']) {
    color: var(--color-text-muted);
  }

  /* Первый столбец закреплён; ширина ограничена, чтобы он не закрывал остальные данные. */
  .data-table :is(th, td):first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    max-width: 9rem;
    border-right: var(--border-width) solid var(--color-border);
    background: var(--color-bg);
  }

  .data-table thead th:first-child {
    z-index: 2;
    background: var(--color-surface);
  }

  .data-table tbody th {
    font-weight: 500;
    overflow-wrap: anywhere;
  }
</style>
