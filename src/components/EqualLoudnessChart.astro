---
// SVG строится при сборке: три кривые ISO 226:2023, логарифмическая ось частоты.
import { equalLoudnessContours } from '@/lib/equal-loudness';

const frequencyPosition = (frequency: number) =>
  Math.log10(frequency / 20) / Math.log10(12500 / 20);
const x = (frequency: number) => frequencyPosition(frequency) * 324;
const y = (level: number) => 216 - (level / 120) * 216;
const styles = [
  { color: 'var(--chart-signal)', dash: undefined },
  { color: 'var(--chart-result)', dash: '6 4' },
  { color: 'var(--chart-series-4)', dash: '8 3 2 3' },
];
---

<div class="equal-loudness-chart">
  <svg class="equal-loudness-labels" width="100%" height="330" xmlns="http://www.w3.org/2000/svg">
    <g fill="var(--chart-label)" font-size="14">
      <text x="12" y="22">
        Уровень, дБ SPL
      </text>
      <text x="50%" y="300" text-anchor="middle">
        Частота, Гц
      </text>
      <text x="50%" y="320" text-anchor="middle">
        (логарифмическая шкала)
      </text>
    </g>
    <g fill="var(--chart-label)" font-size="14">
      {[0, 40, 80, 120].map((level) => (
        <text x="36" y={260 - (level / 120) * 220 + 5} text-anchor="end">
          {level}
        </text>
      ))}
    </g>
  </svg>
  <svg
    class="equal-loudness-plot"
    height="220"
    viewBox="0 0 324 216"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <g stroke="var(--chart-grid)" stroke-width="1">
      {[0, 40, 80, 120].map((level) => (
        <path d={`M0 ${y(level)}H324`} />
      ))}
      {[20, 100, 1000, 12500].map((frequency) => (
        <path d={`M${x(frequency)} 0V216`} />
      ))}
    </g>
    <path d="M0 0V216H324" fill="none" stroke="var(--chart-axis)" stroke-width="1.5" />
    {equalLoudnessContours.map(({ points }, index) => (
      <path
        d={points
          .map(
            ({ frequencyHz, dbSpl }, i) =>
              `${i === 0 ? 'M' : 'L'}${x(frequencyHz).toFixed(2)} ${y(dbSpl).toFixed(2)}`,
          )
          .join(' ')}
        fill="none"
        stroke={styles[index].color}
        stroke-width="2.5"
        stroke-dasharray={styles[index].dash}
      />
    ))}
  </svg>
  <svg
    class="equal-loudness-axis"
    height="280"
    aria-hidden="true"
    fill="var(--chart-label)"
    font-size="14"
  >
    {[
      { frequency: 20, label: '20' },
      { frequency: 100, label: '100' },
      { frequency: 1000, label: '1 000' },
      { frequency: 12500, label: '12 500' },
    ].map(({ frequency, label }) => (
      <text
        x={`${frequencyPosition(frequency) * 100}%`}
        y="280"
        text-anchor={frequency === 12500 ? 'end' : 'middle'}
      >
        {label}
      </text>
    ))}
  </svg>
</div>

<div class="equal-loudness-legend" aria-label="Легенда графика">
  {equalLoudnessContours.map(({ phon }, index) => (
    <span>
      <svg viewBox="0 0 24 12" width="24" height="12" aria-hidden="true">
        <path
          d="M0 6H24"
          stroke={styles[index].color}
          stroke-width="2.5"
          stroke-dasharray={styles[index].dash}
        />
      </svg>
      {phon} фон
    </span>
  ))}
</div>

<style>
  /* Подписи остаются в пикселях; по ширине масштабируются только линии. */
  .equal-loudness-chart {
    position: relative;
    height: 330px;
    font-family: var(--font-ui);
  }

  .equal-loudness-labels {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 330px;
  }

  .equal-loudness-plot,
  .equal-loudness-axis {
    position: absolute;
    left: 44px;
    width: calc(100% - 60px);
    overflow: visible;
  }

  .equal-loudness-plot {
    top: 40px;
    height: 220px;
  }

  .equal-loudness-axis {
    top: 0;
    height: 284px;
  }

  .equal-loudness-plot path {
    vector-effect: non-scaling-stroke;
  }

  /* Легенда сохраняет размер шрифта при масштабировании основного SVG. */
  .equal-loudness-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 16px;
    padding: 0 12px 12px;
    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.4;
    color: var(--chart-label);
  }

  .equal-loudness-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .equal-loudness-legend svg {
    flex: none;
  }
</style>
