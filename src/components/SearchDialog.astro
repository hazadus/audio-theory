---
// Диалог поиска на нативном <dialog>: showModal даёт ограничение фокуса и недоступный фон.
// Выдача и состояния поиска — в `search-controller.ts`; выбор результатов клавишами — там же.
import Icon from '@/components/Icon.astro';
import { withBase } from '@/lib/urls';
---

<dialog
  class="search-dialog"
  data-search-dialog
  aria-labelledby="search-title"
  data-pagefind-ignore
>
  <div class="panel">
    <h2 id="search-title" class="visually-hidden">
      Поиск
    </h2>
    <form class="field" role="search" data-search-form>
      <span class="field-icon">
        <Icon name="search" size={20} />
      </span>
      <input
        type="text"
        name="q"
        data-search-input
        role="combobox"
        aria-autocomplete="list"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-label="Поиск по материалам"
        placeholder="Статья или термин"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
      />
      <kbd class="esc" aria-hidden="true">
        Esc
      </kbd>
      <button type="button" class="cancel" data-search-close>
        <span class="cancel-icon">
          <Icon name="x" size={18} />
        </span>
        <span class="cancel-label">Отмена</span>
      </button>
    </form>
    <div class="body" data-search-body data-state="empty">
      <p class="hint" data-search-hint>
        Ищем по названиям, тексту статей и английским терминам. Например: «частота дискретизации»,
        «Nyquist», «аналоговый сигнал».
      </p>
      <p class="status" role="status" data-search-status></p>
      <p class="note" data-search-none hidden>
        Проверьте написание или попробуйте английский термин, например «Nyquist».
      </p>
      <div class="note" data-search-error hidden>
        <p>Проверьте соединение и повторите попытку.</p>
        <p class="actions">
          <button type="button" class="retry" data-search-retry>
            Повторить
          </button>
          <a href={withBase('/materials/')}>Все материалы</a>
        </p>
      </div>
      <ul
        class="results"
        id="search-results"
        role="listbox"
        aria-label="Результаты поиска"
        data-search-results
        hidden
      ></ul>
    </div>
    <ul class="keys" aria-label="Горячие клавиши">
      <li>
        <kbd>↑</kbd>
        <kbd>↓</kbd>выбор
      </li>
      <li>
        <kbd>Enter</kbd>открыть
      </li>
      <li>
        <kbd>Esc</kbd>закрыть
      </li>
    </ul>
  </div>
</dialog>

<script>
  import { shouldOpenSearch } from '@/lib/search-dialog';
  import { initSearchResults } from '@/lib/search-controller';

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]');

  if (dialog && input) {
    let opener: HTMLElement | null = null;
    let pressStartedOnBackdrop = false;

    // Элемент для возврата фокуса: нажатая кнопка (Safari не фокусирует кнопку мышью) или текущий фокус.
    const open = (from?: HTMLElement) => {
      if (dialog.open) return;
      const active = document.activeElement;
      opener = from ?? (active instanceof HTMLElement && active !== document.body ? active : null);
      document.documentElement.setAttribute('data-search-active', '');
      dialog.showModal();
      syncViewport();
      input.focus();
      input.select();
    };

    initSearchResults(dialog, input, {
      // Переход по результату: фокус отдаёт браузер цели перехода, а не кнопке-инициатору.
      onNavigate: () => {
        opener = null;
        dialog.close();
      },
    });

    for (const trigger of document.querySelectorAll<HTMLElement>('[data-search-open]')) {
      trigger.hidden = false;
      trigger.addEventListener('click', (event) => {
        // Ссылка-триггер без JS ведёт на список материалов; с JS открывает окно поиска.
        event.preventDefault();
        open(trigger);
      });
    }

    document.addEventListener('keydown', (event) => {
      if (!shouldOpenSearch(event)) return;
      event.preventDefault();
      open();
    });

    // Tab по кругу внутри окна: без этого фокус из последнего элемента уходит в интерфейс браузера.
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const items = [
        ...dialog.querySelectorAll<HTMLElement>(
          'input, button:not([disabled]), a[href]:not([tabindex="-1"])',
        ),
      ].filter((el) => el.getClientRects().length > 0);
      if (items.length === 0) return;
      // Переход делаем сами: Safari по умолчанию пропускает кнопки, и Tab выводил бы фокус из окна.
      const index = items.indexOf(document.activeElement as HTMLElement);
      const step = event.shiftKey ? -1 : 1;
      const next = items[(index + step + items.length) % items.length];
      event.preventDefault();
      next.focus();
    });

    dialog.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());
    // Закрытие по затемнению: нажатие и отпускание должны оба прийтись на сам <dialog>, а не на панель.
    dialog.addEventListener('pointerdown', (event) => {
      pressStartedOnBackdrop = event.target === dialog;
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog && pressStartedOnBackdrop) dialog.close();
    });
    dialog.querySelector('[data-search-form]')?.addEventListener('submit', (event) => {
      event.preventDefault();
    });

    // Экранная клавиатура: в iOS она не меняет dvh, зато уменьшает visualViewport. Высота и сдвиг окна
    // берутся оттуда, чтобы поле, «Отмена» и выбранный результат оставались над клавиатурой.
    const viewport = window.visualViewport;
    const syncViewport = () => {
      if (!viewport) return;
      const root = document.documentElement.style;
      root.setProperty('--search-viewport-height', `${viewport.height}px`);
      root.setProperty('--search-viewport-top', `${viewport.offsetTop}px`);
    };
    const clearViewport = () => {
      document.documentElement.style.removeProperty('--search-viewport-height');
      document.documentElement.style.removeProperty('--search-viewport-top');
    };
    viewport?.addEventListener('resize', syncViewport);
    viewport?.addEventListener('scroll', syncViewport);

    // close срабатывает и для Esc, и для кнопки, и для затемнения: общий возврат состояния.
    dialog.addEventListener('close', () => {
      document.documentElement.removeAttribute('data-search-active');
      clearViewport();
      if (opener?.isConnected) opener.focus();
      opener = null;
    });
  }
</script>

<style is:global>
  /* Прокрутка страницы под открытым диалогом заблокирована. */
  html[data-search-active] {
    overflow: hidden;
  }

  .search-dialog {
    box-sizing: border-box;
    width: min(640px, 100% - 2 * var(--page-gutter));
    max-width: none;
    max-height: calc(100dvh - 12vh - var(--space-6));
    margin: 12vh auto 0;
    padding: 0;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-lg);
    color: var(--color-text);
    font-family: var(--font-ui);
  }

  .search-dialog::backdrop {
    background: var(--color-scrim);
  }

  /* Высоту ограничивает панель, а не <dialog>: Safari сворачивает flex: 1 в автовысоте до 0. */
  .search-dialog .panel {
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - 12vh - var(--space-6));
  }

  .search-dialog .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .search-dialog .field {
    display: flex;
    flex: none;
    align-items: center;
    gap: 10px;
    height: 56px;
    margin: 0;
    padding: 0 12px 0 16px;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .search-dialog .field-icon {
    display: inline-flex;
    color: var(--color-text-muted);
  }

  .search-dialog input {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: 1.125rem;
  }

  .search-dialog input:focus,
  .search-dialog input:focus-visible {
    outline: none;
    box-shadow: none;
  }

  /* Рамка фокуса у поля заменена видимой линией под строкой, чтобы фокус не пропадал. */
  .search-dialog .field:focus-within {
    box-shadow: inset 0 calc(-1 * var(--border-width-strong)) 0 var(--color-focus);
  }

  .search-dialog input::placeholder {
    color: var(--color-text-muted);
  }

  .search-dialog kbd {
    padding: 3px 6px;
    border: var(--border-width) solid var(--color-border);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
  }

  .search-dialog .cancel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .search-dialog .cancel:hover {
    color: var(--color-text);
  }

  .search-dialog .cancel-icon {
    display: inline-flex;
  }

  /* На широком экране подпись «Отмена» остаётся только как доступное имя кнопки с крестиком. */
  .search-dialog .cancel-label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .search-dialog .body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: var(--space-4) 18px;
  }

  .search-dialog .hint {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    hyphens: manual;
    line-height: 1.5;
  }

  .search-dialog .status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .search-dialog .status:empty {
    display: none;
  }

  .search-dialog .body[data-state='loading'] .status::before {
    content: '';
    width: 14px;
    height: 14px;
    border: 2px solid var(--color-border);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: search-spin 0.8s linear infinite;
  }

  @keyframes search-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-dialog .body[data-state='loading'] .status::before {
      animation: none;
    }
  }

  .search-dialog .body[data-state='none'] .status,
  .search-dialog .body[data-state='error'] .status {
    color: var(--color-text);
    font-weight: 600;
  }

  .search-dialog .note {
    margin: 6px 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .search-dialog .note p {
    margin: 0;
  }

  .search-dialog .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-top: 10px;
  }

  .search-dialog .retry {
    min-height: 40px;
    padding: 0 14px;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    font: inherit;
  }

  .search-dialog .results {
    display: grid;
    gap: 2px;
    margin: 8px -8px 0;
    padding: 0;
    list-style: none;
  }

  .search-dialog .hit {
    display: block;
    padding: 10px 8px;
    border-radius: var(--radius-md);
    color: inherit;
    text-decoration: none;
  }

  .search-dialog .hit {
    position: relative;
  }

  .search-dialog .hit:hover {
    background: var(--color-surface);
  }

  /* Выбор клавишами: плашка, полоса слева и значок ↵ — не только цвет. */
  .search-dialog .hit[aria-selected='true'] {
    background: var(--color-accent-soft);
    box-shadow: inset 3px 0 0 var(--color-accent);
  }

  .search-dialog .hit[aria-selected='true']::after {
    content: '↵';
    position: absolute;
    top: 10px;
    right: 10px;
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  .search-dialog .hit[aria-selected='true'] .hit-path {
    padding-right: 24px;
  }

  .search-dialog .hit-path {
    display: block;
    font-weight: 600;
    line-height: 1.4;
  }

  .search-dialog .hit-section {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .search-dialog .hit-excerpt {
    display: block;
    margin-top: 4px;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .search-dialog .hit-excerpt mark {
    color: var(--color-text);
  }

  .search-dialog .keys {
    display: flex;
    flex: none;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0;
    padding: 10px 16px;
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    list-style: none;
  }

  .search-dialog .keys li {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .search-dialog .keys kbd {
    padding: 1px 5px;
    border-bottom-width: var(--border-width);
    background: transparent;
  }

  /* Смартфон: весь экран, без скругления; в верхней строке поле и «Отмена». */
  @media (width < 600px) {
    .search-dialog {
      width: 100%;
      /* Доступная высота: с клавиатурой — visualViewport, иначе динамическая высота окна. */
      height: var(--search-viewport-height, 100dvh);
      max-height: none;
      margin: 0;
      inset: var(--search-viewport-top, 0) 0 auto 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .search-dialog .panel {
      height: 100%;
      max-height: none;
    }

    /* Вырез и жестовая полоса: отступы safe-area у верхней строки, списка и нижнего края. */
    .search-dialog .field {
      height: auto;
      padding: calc(8px + env(safe-area-inset-top)) calc(8px + env(safe-area-inset-right)) 8px
        calc(14px + env(safe-area-inset-left));
    }

    .search-dialog .body {
      overscroll-behavior: contain;
      padding-right: calc(18px + env(safe-area-inset-right));
      padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
      padding-left: calc(18px + env(safe-area-inset-left));
    }

    .search-dialog .results {
      margin-inline: -8px;
    }

    .search-dialog input {
      height: 44px;
      font-size: 1.25rem;
    }

    .search-dialog .esc,
    .search-dialog .keys,
    .search-dialog .cancel-icon {
      display: none;
    }

    .search-dialog .cancel {
      padding: 0 10px;
      color: var(--color-link);
      font-size: var(--text-ui);
      font-weight: 500;
    }

    .search-dialog .cancel-label {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      clip-path: none;
    }
  }
</style>
