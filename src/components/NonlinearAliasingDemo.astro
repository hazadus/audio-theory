---
// «Два тона и отражения»: тоны 19 и 20 кГц через кривую без памяти при выбранной частоте
// дискретизации и кратности передискретизации, спектр выхода с тонами, настоящими сочетаниями,
// отражениями и уровнями аналоговой цепи, прослушивание петли до и после кривой той же моделью.
// Начальный рисунок и подпись создаются при сборке; без JavaScript, во время загрузки и при ошибке
// параметры неактивны.
import Icon from '@/components/Icon.astro';
import { demoCaptions } from '@/lib/demo-captions';
import {
  aliasingCurves,
  aliasingDriveRange,
  defaultAliasing,
  factors,
  renderAliasing,
  sampleRates,
} from '@/lib/nonlinear-aliasing';
import {
  aliasingCaption,
  aliasingStatus,
  aliasingSvg,
  curveNames,
  driveText,
  factorText,
  sampleRateText,
} from '@/lib/nonlinear-aliasing-view';
import { initialVolume } from '@/lib/sampling-audio';
import { volumeStep, volumeText } from '@/lib/sampling-player';
import '@/styles/nonlinear-aliasing.css';

interface Props {
  /** Номер рисунка: визуализации и рисунки нумеруются одной последовательностью. */
  figure: number;
  /** Якорь для ссылок `#id`; английский kebab-case. */
  id?: string;
}

const { figure, id = demoCaptions.NonlinearAliasingDemo.defaultId } = Astro.props;
const p = defaultAliasing;
const render = renderAliasing(p);
const status = aliasingStatus(render);
---

<figure
  id={id}
  class="aliasing-demo"
  aria-labelledby={`${id}-name`}
  data-nonlinear-aliasing
  data-state="static"
>
  <div class="aliasing-demo-head">
    <span class="aliasing-demo-label">Визуализация {figure}</span>
    <span class="aliasing-demo-name" id={`${id}-name`}>
      {demoCaptions.NonlinearAliasingDemo.name}
    </span>
  </div>
  <div
    class="aliasing-demo-chart"
    role="region"
    aria-label="Спектр выхода кривой"
    tabindex="0"
    data-chart
    set:html={aliasingSvg(render, id)}
  />
  <ul class="aliasing-demo-legend" aria-label="Легенда">
    <li>
      <i class="tone"></i>входные тоны 19 и 20 кГц
    </li>
    <li>
      <i class="product"></i>сочетания частот, как в аналоговой цепи
    </li>
    <li>
      <i class="alias"></i>отражения
    </li>
    <li>
      <i class="cross" aria-hidden="true">
        ×
      </i>
      уровень в аналоговой цепи
    </li>
  </ul>
  <div class="aliasing-demo-status">
    <p data-status-setup>{status.setup}</p>
    <p data-status-aliases>{status.aliases}</p>
    <p data-status-products>{status.products}</p>
  </div>
  <p class="visually-hidden" aria-live="polite" data-announce></p>
  <fieldset class="aliasing-demo-controls" data-controls disabled>
    <legend class="visually-hidden">Параметры опыта</legend>
    <div class="aliasing-demo-grid">
      <div class="aliasing-demo-param">
        <div class="aliasing-demo-select">
          <label for={`${id}-curve`}>Кривая</label>
          <select id={`${id}-curve`} data-select="curve">
            {aliasingCurves.map((curve) => (
              <option value={curve} selected={curve === p.curve}>
                {curveNames[curve]}
              </option>
            ))}
          </select>
        </div>
        <div class="aliasing-demo-param-head">
          <label for={`${id}-drive`}>Входное усиление G</label>
          <output for={`${id}-drive`} data-output="drive">
            {driveText(p.driveDb)}
          </output>
        </div>
        <input
          id={`${id}-drive`}
          class="aliasing-demo-range"
          type="range"
          min={aliasingDriveRange.min}
          max={aliasingDriveRange.max}
          step={aliasingDriveRange.step}
          value={p.driveDb}
          aria-valuetext={driveText(p.driveDb)}
          data-range="drive"
        />
      </div>
      <div class="aliasing-demo-param">
        <div class="aliasing-demo-select">
          <label for={`${id}-rate`}>Частота дискретизации</label>
          <select id={`${id}-rate`} data-select="rate">
            {sampleRates.map((rate) => (
              <option value={rate} selected={rate === p.sampleRate}>
                {sampleRateText(rate)}
              </option>
            ))}
          </select>
        </div>
        <div class="aliasing-demo-select">
          <label for={`${id}-factor`}>Передискретизация</label>
          <select id={`${id}-factor`} data-select="factor">
            {factors.map((factor) => (
              <option value={factor} selected={factor === p.factor}>
                {factorText(factor)}
              </option>
            ))}
          </select>
        </div>
      </div>
    </div>
    <div class="aliasing-demo-actions">
      <button type="button" class="aliasing-demo-reset" data-reset>
        <Icon name="rotate-ccw" size={16} />
        Сбросить
      </button>
    </div>
    <div class="aliasing-demo-audio">
      <p class="aliasing-demo-warning" role="note">
        <Icon name="volume-2" size={18} />
        <span>
          <b>Громкость.</b> Звучат чистые тоны 19 и 20&nbsp;кГц: многие их почти не слышат, а
          отражения после кривой лежат на слышимых частотах. Громкие высокие тоны вредны для слуха и
          твитеров — перед запуском убавьте громкость, особенно в наушниках. Если в исходных тонах
          слышен тон около 1&nbsp;кГц, его создаёт нелинейность усилителя или наушников.
        </span>
      </p>
      <div
        class="aliasing-demo-player"
        role="group"
        aria-label="Аудиопример: тоны до и после кривой"
        data-player-group
        data-mode="ready"
      >
        <button type="button" class="aliasing-demo-play" aria-label="Воспроизвести" data-play>
          <span class="aliasing-demo-play-icon start">
            <Icon name="play" size={18} />
          </span>
          <span class="aliasing-demo-play-icon stop">
            <Icon name="square" size={16} />
          </span>
        </button>
        <div class="aliasing-demo-listen" role="radiogroup" aria-label="Что слушать">
          <label>
            <input type="radio" name={`${id}-listen`} value="dry" data-listen />
            Исходные тоны
          </label>
          <label>
            <input type="radio" name={`${id}-listen`} value="wet" checked data-listen />
            После кривой
          </label>
        </div>
        <div class="aliasing-demo-volume">
          <button type="button" class="aliasing-demo-mute" aria-label="Выключить звук" data-mute>
            <span class="aliasing-demo-mute-icon on">
              <Icon name="volume-2" size={18} />
            </span>
            <span class="aliasing-demo-mute-icon off">
              <Icon name="volume-x" size={18} />
            </span>
          </button>
          <input
            class="aliasing-demo-range compact"
            type="range"
            min="0"
            max="100"
            step={volumeStep}
            value={initialVolume * 100}
            aria-label="Громкость"
            aria-valuetext={volumeText(initialVolume * 100)}
            data-volume
          />
          <span class="aliasing-demo-volume-text" data-volume-text>
            {volumeText(initialVolume * 100)}
          </span>
        </div>
      </div>
      <p class="aliasing-demo-player-state" role="status" data-player-state>
        Остановлен
      </p>
    </div>
    <p class="aliasing-demo-note-text" data-controls-note>
      Параметры и звук работают с включённым JavaScript. Показано начальное состояние.
    </p>
  </fieldset>
  <figcaption class="aliasing-demo-caption">
    <b>Рис. {figure}.</b> <span data-caption>{aliasingCaption(p)}</span>
  </figcaption>
</figure>

<script>
  import { initNonlinearAliasingDemos } from '@/lib/nonlinear-aliasing-controller';

  initNonlinearAliasingDemos();
</script>
