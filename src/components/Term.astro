---
// Термин из глоссария: ссылка на объяснение, английское название при первом упоминании и подсказка с определением.
// Текст берётся из src/data/glossary.json — того же источника, что и страница глоссария.
import glossary from '@/data/glossary.json';
import { findTerm, glossarySchema } from '@/lib/glossary';
import { resolveTarget } from '@/lib/links';
import { nextTermId } from '@/lib/term';

interface Props {
  /** `id` записи глоссария. */
  id: string;
  /** Первое упоминание: полужирное русское название и английское в скобках. */
  firstMention?: boolean;
  /** Место определения термина: оборачивает его в `<dfn>`. */
  define?: boolean;
}

const { id, firstMention = false, define = false } = Astro.props;
const entry = findTerm(glossarySchema.parse(glossary), id);
const href = resolveTarget(entry.target);
const external = 'url' in entry.target;
const popoverId = nextTermId(id);
const Wrapper = define ? 'dfn' : 'span';
---

<span class="term" data-term>
  <Wrapper class:list={['term-name', { first: firstMention }]}>
    <a
      class:list={['term-link', { external }]}
      href={href}
      aria-describedby={popoverId}
      data-term-link
    >
      <slot>{entry.ru}</slot>
    </a>
  </Wrapper>
  {firstMention && (
    <>
      {' '}(
      <i class="term-en" lang="en">
        {entry.en}
      </i>
      )
    </>
  )}
  <button
    type="button"
    class="term-button"
    data-pagefind-ignore
    popovertarget={popoverId}
    aria-label={`Определение: ${entry.ru}`}
    data-term-button
  >
    ?
  </button>
  <span class="term-popover" id={popoverId} popover="manual" data-term-popover data-pagefind-ignore>
    <strong>{entry.ru}</strong> (<i lang="en">{entry.en}</i>) — {entry.definition}
  </span>
</span>

<script>
  import { initTerms } from '@/lib/term-controller';

  initTerms();
</script>

<style is:global>
  /* Термин с подсказкой — точечное подчёркивание; внутренняя ссылка остаётся ссылкой. */
  .term-link {
    text-decoration: underline dotted;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
  }

  .term-name {
    font-style: normal;
  }

  .term-name.first .term-link {
    font-weight: 600;
  }

  .term-en {
    color: var(--color-text-muted);
  }

  /* Кнопка определения нужна только без наведения (тач); с мышью определение открывает hover и фокус. */
  .term-button {
    display: none;
    width: 24px;
    height: 24px;
    margin-inline-start: 4px;
    padding: 0;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 13px;
    line-height: 1;
    vertical-align: 0.1em;
    cursor: pointer;
  }

  @media (hover: none) {
    .term-button {
      display: inline-block;
      /* Область нажатия 44 px без роста видимой кнопки. */
      position: relative;
    }

    .term-button::after {
      content: '';
      position: absolute;
      inset: -10px;
    }
  }

  .term-popover {
    max-width: min(22rem, calc(100vw - 16px));
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: 14px;
    font-style: normal;
    line-height: var(--leading-normal);
  }

  .term-popover.is-enhanced {
    position: fixed;
    inset: auto;
  }

  .term-popover:popover-open {
    display: block;
  }
</style>
