---
// Строка тегов-ссылок: «#» перед подписью, необязательное число статей и ссылка «Все теги» в конце.
// Размер `md` — в статье и в «Часто вместе»: 28 px, на смартфоне 36 px; `sm` — в строках страницы тега: 24 и 32 px.
import type { TagInfo } from '@/lib/tags';
import { tagHref, tagsIndexHref } from '@/lib/tags';
import { withBase } from '@/lib/urls';

interface Props {
  tags: (TagInfo & { count?: number })[];
  label: string;
  size?: 'md' | 'sm';
  /** Добавить «Все теги» последним пунктом. */
  all?: boolean;
}

const { tags, label, size = 'md', all = false } = Astro.props;
---

<ul class:list={['tag-list', size]} aria-label={label} data-pagefind-ignore>
  {tags.map((tag) => (
    <li>
      <a class="tag" href={withBase(tagHref(tag.id))}>
        <span class="hash" aria-hidden="true">
          #
        </span>
        {tag.title}
        {tag.count !== undefined && <span class="count">{tag.count}</span>}
      </a>
    </li>
  ))}
  {all && (
    <li>
      <a class="all" href={withBase(tagsIndexHref)}>
        Все теги
      </a>
    </li>
  )}
</ul>

<style>
  .tag-list {
    --tag-h: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
  }

  .tag-list.sm {
    --tag-h: 24px;
    gap: 6px;
  }

  @media (width < 600px) {
    .tag-list {
      --tag-h: 36px;
    }

    .tag-list.sm {
      --tag-h: 32px;
    }
  }

  .tag {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    height: var(--tag-h);
    padding: 0 10px;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .sm .tag {
    padding: 0 var(--space-2);
    border-color: transparent;
    font-size: 13px;
    font-weight: 400;
  }

  .tag:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .sm .tag:hover {
    border-color: transparent;
  }

  .hash {
    margin-right: 2px;
    color: var(--color-text-muted);
  }

  .sm .hash {
    margin-right: 1px;
  }

  .count {
    margin-left: 6px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
  }

  .all {
    display: inline-flex;
    align-items: center;
    height: var(--tag-h);
    padding: 0 var(--space-1);
    color: var(--color-link);
    font-size: 14px;
  }

  .all:hover {
    color: var(--color-accent-hover);
  }
</style>
