---
// Кнопка темы переключает режимы по кругу; без JS скрыта, действует системная тема.
import Icon from '@/components/Icon.astro';
---

<button type="button" class="theme-toggle" data-theme-toggle hidden>
  <span data-theme-icon="light">
    <Icon name="sun" size={18} />
  </span>
  <span data-theme-icon="dark" hidden>
    <Icon name="moon" size={18} />
  </span>
  <span data-theme-icon="auto" hidden>
    <Icon name="monitor" size={18} />
  </span>
</button>

<script>
  import {
    applyTheme,
    nextTheme,
    parseTheme,
    readStoredTheme,
    themeButtonLabel,
    themeStorageKey,
    writeStoredTheme,
    type ThemeMode,
  } from '@/lib/theme';

  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (button) {
    // Режим в окне хранится здесь: при отказе storage переключение продолжает работать.
    let mode: ThemeMode = readStoredTheme();

    const render = () => {
      applyTheme(document.documentElement, mode);
      const label = themeButtonLabel(mode);
      button.setAttribute('aria-label', label);
      button.title = label;
      for (const icon of button.querySelectorAll<HTMLElement>('[data-theme-icon]')) {
        icon.hidden = icon.dataset.themeIcon !== mode;
      }
    };

    button.addEventListener('click', () => {
      mode = nextTheme(mode);
      writeStoredTheme(mode);
      render();
    });
    // Выбор из другой вкладки.
    window.addEventListener('storage', (event) => {
      if (event.key === themeStorageKey || event.key === null) {
        mode = parseTheme(event.newValue);
        render();
      }
    });
    button.hidden = false;
    render();
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    color: var(--color-text);
    cursor: pointer;
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover {
    border-color: var(--color-border-strong);
  }

  [data-theme-icon] {
    display: inline-flex;
  }

  [data-theme-icon][hidden] {
    display: none;
  }
</style>
