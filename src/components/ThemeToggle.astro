---
// Кнопка темы переключает режимы по кругу; без JS скрыта, действует системная тема.
import Icon from '@/components/Icon.astro';
---

<button type="button" class="theme-toggle" data-theme-toggle hidden>
  <span data-theme-icon="light">
    <Icon name="sun" size={18} />
  </span>
  <span data-theme-icon="dark" hidden>
    <Icon name="moon" size={18} />
  </span>
  <span data-theme-icon="auto" hidden>
    <Icon name="monitor" size={18} />
  </span>
</button>

<script>
  import { nextTheme, themeButtonLabel } from '@/lib/theme';
  import { getThemeMode, onThemeChange, setThemeMode } from '@/lib/theme-controller';

  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (button) {
    button.addEventListener('click', () => setThemeMode(nextTheme(getThemeMode())));
    button.hidden = false;
    onThemeChange((mode) => {
      const label = themeButtonLabel(mode);
      button.setAttribute('aria-label', label);
      button.title = label;
      for (const icon of button.querySelectorAll<HTMLElement>('[data-theme-icon]')) {
        icon.hidden = icon.dataset.themeIcon !== mode;
      }
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    color: var(--color-text);
    cursor: pointer;
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover {
    border-color: var(--color-border-strong);
  }

  [data-theme-icon] {
    display: inline-flex;
  }

  [data-theme-icon][hidden] {
    display: none;
  }
</style>
