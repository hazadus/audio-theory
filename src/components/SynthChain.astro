---
// Схема одноголосного синтезатора серии статей: источники → микшер → фильтр НЧ → VCA → WAV, ADSR
// управляет VCA. Часть, которую разбирает статья, выделена рамкой, толщиной линий и подписью.
import Figure from '@/components/Figure.astro';

type Part = 'sources' | 'envelope' | 'filter' | 'render';

interface Props {
  id: string;
  number: number;
  /** Часть цепочки, которую разбирает статья. */
  highlight: Part;
  caption: string;
}

const { id, number, highlight, caption } = Astro.props;

interface Box {
  key: string;
  part: Part;
  x: number;
  y: number;
  w: number;
  label: string;
}

const h = 36;
const boxes: Box[] = [
  { key: 'osc1', part: 'sources', x: 8, y: 40, w: 78, label: 'Осц. 1' },
  { key: 'osc2', part: 'sources', x: 94, y: 40, w: 78, label: 'Осц. 2' },
  { key: 'sub', part: 'sources', x: 180, y: 40, w: 78, label: 'Саб' },
  { key: 'noise', part: 'sources', x: 266, y: 40, w: 78, label: 'Шум' },
  { key: 'mixer', part: 'sources', x: 106, y: 120, w: 140, label: 'Микшер' },
  { key: 'filter', part: 'filter', x: 106, y: 192, w: 140, label: 'Фильтр НЧ' },
  { key: 'vca', part: 'envelope', x: 106, y: 264, w: 140, label: 'VCA' },
  { key: 'adsr', part: 'envelope', x: 266, y: 264, w: 78, label: 'ADSR' },
  { key: 'wav', part: 'render', x: 106, y: 336, w: 140, label: 'WAV' },
];
const frames: Record<Part, { x: number; y: number; w: number; h: number }> = {
  sources: { x: 2, y: 30, w: 348, h: 136 },
  filter: { x: 98, y: 184, w: 156, h: 52 },
  envelope: { x: 98, y: 256, w: 252, h: 52 },
  render: { x: 98, y: 328, w: 156, h: 52 },
};
const frame = frames[highlight];
// Маркер стрелки ставится на конец пути, поэтому каждая стрелка — отдельный путь.
const arrows = [
  ...boxes
    .filter((b) => b.y === 40)
    .map((b) => `M${b.x + b.w / 2} ${b.y + h}L${176 + (b.x + b.w / 2 - 176) / 3} 118`),
  `M176 ${120 + h}V190`,
  `M176 ${192 + h}V262`,
  `M176 ${264 + h}V334`,
  'M266 282H248',
];
const titles: Record<Part, string> = {
  sources: 'источники и микшер',
  envelope: 'огибающая и VCA',
  filter: 'фильтр НЧ',
  render: 'запись в WAV',
};
const descriptions: Record<Part, string> = {
  sources: 'источники и микшер',
  envelope: 'огибающая ADSR и усилитель VCA',
  filter: 'фильтр нижних частот',
  render: 'запись результата в WAV',
};
const alt = `Цепочка сигнала одного голоса сверху вниз. Осциллятор 1, осциллятор 2, саб-осциллятор и шум сходятся в микшер; дальше идут фильтр нижних частот, усилитель VCA и запись в WAV. Огибающая ADSR справа управляет VCA. Выделена часть, которую разбирает статья: ${descriptions[highlight]}.`;
---

<Figure id={id} number={number} caption={caption} alt={alt} name="Цепочка сигнала голоса">
  <svg
    viewBox="0 0 352 388"
    style="max-width: 352px; margin-inline: auto"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <marker
        id={`${id}-arrow`}
        viewBox="0 0 8 8"
        refX="7"
        refY="4"
        markerWidth="8"
        markerHeight="8"
        orient="auto"
      >
        <path d="M0 0L8 4L0 8Z" fill="var(--chart-axis)"></path>
      </marker>
    </defs>
    <rect
      x={frame.x}
      y={frame.y}
      width={frame.w}
      height={frame.h}
      rx="10"
      fill="var(--color-accent-soft)"
      stroke="var(--color-accent)"
      stroke-width="1.5"
      stroke-dasharray="6 4"
    ></rect>
    <text x="8" y="21" fill="currentColor" font-weight="600" font-size="16">
      Выделено: {titles[highlight]}
    </text>
    {arrows.map((d) => (
      <path
        d={d}
        fill="none"
        stroke="var(--chart-axis)"
        stroke-width="1.5"
        marker-end={`url(#${id}-arrow)`}
      />
    ))}
    {boxes.map((b) => (
      <g>
        <rect
          x={b.x}
          y={b.y}
          width={b.w}
          height={h}
          rx="6"
          fill="var(--color-surface)"
          stroke={b.part === highlight ? 'var(--color-accent)' : 'var(--chart-axis)'}
          stroke-width={b.part === highlight ? 2.5 : 1}
        />
        <text
          x={b.x + b.w / 2}
          y={b.y + 23}
          text-anchor="middle"
          fill="var(--color-text)"
          font-weight={b.part === highlight ? 600 : 400}
          font-size="16"
        >
          {b.label}
        </text>
      </g>
    ))}
  </svg>
</Figure>
