---
// Связанный абзац и заметка: порядок DOM сохраняется, высота строки исключает перекрытия без JS.
import { marginNoteItems, type MarginNoteItem } from '@/lib/margin-note';
import { resolveTarget } from '@/lib/links';

interface Props {
  /** 1–3 ссылки; раздел подписывается «Статья → раздел». В слоте — один абзац. */
  items: MarginNoteItem[];
}

const items = marginNoteItems.parse(Astro.props.items);
---

<div class="margin-note-block">
  <slot />
  <aside class="margin-note" aria-label="Подробнее" data-pagefind-ignore>
    <span class="margin-note-label">Подробнее</span>
    <ul>
      {items.map((item) => (
        <li>
          <a href={resolveTarget(item.target)}>
            <span class="margin-note-title">{item.label}</span>
            <span class="margin-note-description">{item.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
</div>

<style>
  .margin-note-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    min-width: 0;
  }

  .margin-note-block > :global(p) {
    min-width: 0;
    margin: 0;
    text-wrap: pretty;
  }

  .margin-note {
    min-width: 0;
    padding: var(--space-3) 14px var(--space-2);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-family: var(--font-ui);
    line-height: 1.35;
  }

  .margin-note-label {
    display: block;
    color: var(--color-text-muted);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .margin-note ul {
    display: grid;
    gap: 2px;
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .margin-note a {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1px;
    min-height: 44px;
    text-decoration: none;
  }

  .margin-note-title {
    font-size: 14px;
    font-weight: 500;
  }

  .margin-note-description {
    color: var(--color-text-muted);
    font-size: 13px;
    font-weight: 400;
  }

  .margin-note a:hover .margin-note-title {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  /* Строка занимает высоту большего из абзаца и заметки; следующий блок начинается ниже обоих. */
  @media screen and (width >= 1280px) {
    .margin-note-block {
      grid-template-columns: minmax(0, 1fr) 208px;
      column-gap: 48px;
      align-items: start;
    }

    .margin-note {
      padding: 0;
      background: none;
    }

    .margin-note ul {
      gap: 10px;
      margin-top: 10px;
    }
  }

  @media print {
    .margin-note {
      break-inside: avoid;
      print-color-adjust: exact;
    }

    .margin-note-label {
      font-size: 7pt;
    }

    .margin-note-title {
      font-size: 8pt;
    }

    .margin-note-description {
      font-size: 7.5pt;
    }
  }
</style>
