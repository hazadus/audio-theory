---
// Эксперимент дискретизации: график, легенда, статус, параметры и подпись «Рис. N.».
// При сборке рисуется начальное состояние 8 000 Гц; скрипт включает параметры и перерисовывает тот же SVG.
// Без JS, во время загрузки и при ошибке параметры неактивны, а сообщение объясняет почему.
import Icon from '@/components/Icon.astro';
import { samplingExperiment, signalFrequency } from '@/lib/sampling';
import { initialVolume, listenDuration } from '@/lib/sampling-audio';
import { formatTime, positionText, seekStep, volumeStep, volumeText } from '@/lib/sampling-player';
import {
  initialState,
  maxSampleRate,
  minSampleRate,
  nyquistMark,
  presets,
  sampleRateStep,
  sampleRateText,
  sliderPosition,
} from '@/lib/sampling-controls';
import {
  formatNumber,
  samplingCaption,
  samplingChartSvg,
  samplingStatus,
  showsAlias,
} from '@/lib/sampling-view';

interface Props {
  /** Номер рисунка: визуализации и рисунки нумеруются одной последовательностью. */
  figure: number;
  /** Якорь для ссылок `#id`; английский kebab-case. */
  id?: string;
}

const { figure, id = 'sampling-demo' } = Astro.props;

const { sampleRate, alias } = initialState;
const experiment = samplingExperiment(sampleRate);
const status = samplingStatus(experiment);
const valueText = sampleRateText(sampleRate);
const warning = `Результат — чистый тон ${formatNumber(signalFrequency)}\u00a0Гц. Перед запуском убавьте громкость, особенно в наушниках.`;
---

<figure
  class="sampling-demo"
  id={id}
  aria-labelledby={`${id}-name`}
  data-sampling-demo
  data-state="static"
  data-tone={status.tone}
>
  <div class="sampling-demo-head">
    <span class="sampling-demo-label">Визуализация {figure}</span>
    <span class="sampling-demo-name" id={`${id}-name`}>
      Отсчёты синусоиды при разной частоте дискретизации
    </span>
  </div>
  <div class="sampling-demo-chart" data-chart set:html={samplingChartSvg(experiment, alias, id)} />
  <div class="sampling-demo-body" data-body>
    <ul class="sampling-demo-legend" aria-label="Легенда">
      <li>
        <span class="sampling-demo-key signal" aria-hidden="true"></span>сигнал 1&nbsp;кГц
      </li>
      <li>
        <span class="sampling-demo-key sample" aria-hidden="true"></span>отсчёты
      </li>
      <li data-legend-alias hidden={!showsAlias(experiment, alias)}>
        <span class="sampling-demo-key result" aria-hidden="true"></span>синусоида, через которую
        проходят те же отсчёты
      </li>
    </ul>
    <p class="sampling-demo-status">
      <span class="sampling-demo-icon ok">
        <Icon name="check" size={18} />
      </span>
      <span class="sampling-demo-icon alert">
        <Icon name="triangle-alert" size={18} />
      </span>
      <span>
        <b data-status-title>{status.title}</b> <span data-status-text>{status.text}</span>
      </span>
    </p>
  </div>
  <p class="visually-hidden" aria-live="polite" data-announce></p>
  <fieldset class="sampling-demo-controls" data-controls disabled>
    <legend class="visually-hidden">Параметры эксперимента</legend>
    <div class="sampling-demo-param">
      <div class="sampling-demo-param-head">
        <label for={`${id}-rate`}>
          Частота дискретизации <i>f</i>
          <sub>s</sub>
        </label>
        <output for={`${id}-rate`} data-rate-value>
          {valueText}
        </output>
      </div>
      <input
        id={`${id}-rate`}
        class="sampling-demo-range"
        type="range"
        min={minSampleRate}
        max={maxSampleRate}
        step={sampleRateStep}
        value={sampleRate}
        aria-valuetext={valueText}
        style={`--fill: ${sliderPosition(sampleRate)}; --mark: ${sliderPosition(nyquistMark)}`}
        data-rate
      />
      <div class="sampling-demo-scale" aria-hidden="true">
        <span>{sampleRateText(minSampleRate)}</span>
        <span class="sampling-demo-mark">
          риска — 2<i>f</i> = {formatNumber(nyquistMark)}&nbsp;Гц
        </span>
        <span>{sampleRateText(maxSampleRate)}</span>
      </div>
    </div>
    <div class="sampling-demo-actions">
      <div class="sampling-demo-presets" role="group" aria-label="Примеры">
        <span class="sampling-demo-presets-label" aria-hidden="true">
          Примеры:
        </span>
        {presets.map((preset) => (
          <button
            type="button"
            class="sampling-demo-preset"
            aria-pressed={preset.value === sampleRate ? 'true' : 'false'}
            data-preset={preset.value}
          >
            {preset.label}
          </button>
        ))}
      </div>
      <div class="sampling-demo-buttons">
        <button
          type="button"
          class="sampling-demo-switch"
          role="switch"
          aria-checked={alias ? 'true' : 'false'}
          data-alias
        >
          <span class="sampling-demo-track" aria-hidden="true">
            <span></span>
          </span>
          Видимая синусоида
        </button>
        <button type="button" class="sampling-demo-reset" data-reset>
          <Icon name="rotate-ccw" size={16} />
          Сбросить
        </button>
      </div>
    </div>
    <div class="sampling-demo-audio">
      <p class="sampling-demo-warning" role="note">
        <Icon name="volume-2" size={18} />
        <span>
          <b>Громкость.</b> <span data-warning-text>{warning}</span>
        </span>
      </p>
      <div
        class="sampling-demo-player"
        role="group"
        aria-label="Аудиопример: восстановленный сигнал"
        data-player-group
        data-mode="ready"
      >
        <button type="button" class="sampling-demo-play" aria-label="Воспроизвести" data-play>
          <span class="sampling-demo-play-icon start">
            <Icon name="play" size={18} />
          </span>
          <span class="sampling-demo-play-icon pause">
            <Icon name="pause" size={18} />
          </span>
        </button>
        <button type="button" class="sampling-demo-stop" aria-label="Стоп" data-stop>
          <Icon name="square" size={16} />
        </button>
        <div class="sampling-demo-position">
          <span class="sampling-demo-time" data-position-time>
            {formatTime(0)}
          </span>
          <input
            class="sampling-demo-range compact"
            type="range"
            min="0"
            max={listenDuration}
            step={seekStep}
            value="0"
            aria-label="Позиция"
            aria-valuetext={positionText(0, listenDuration)}
            style="--fill: 0"
            data-position
          />
          <span class="sampling-demo-time">{formatTime(listenDuration)}</span>
        </div>
        <div class="sampling-demo-volume">
          <button type="button" class="sampling-demo-mute" aria-label="Выключить звук" data-mute>
            <span class="sampling-demo-mute-icon on">
              <Icon name="volume-2" size={18} />
            </span>
            <span class="sampling-demo-mute-icon off">
              <Icon name="volume-x" size={18} />
            </span>
          </button>
          <input
            class="sampling-demo-range compact"
            type="range"
            min="0"
            max="100"
            step={volumeStep}
            value={initialVolume * 100}
            aria-label="Громкость"
            aria-valuetext={volumeText(initialVolume * 100)}
            style={`--fill: ${initialVolume * 100}`}
            data-volume
          />
          <span class="sampling-demo-volume-text" data-volume-text>
            {volumeText(initialVolume * 100)}
          </span>
        </div>
      </div>
      <p class="sampling-demo-player-state" role="status" data-player-state>
        Остановлен
      </p>
    </div>
    <p class="sampling-demo-note" data-controls-note>
      Параметры работают с включённым JavaScript. Рисунок показывает начальное состояние.
    </p>
  </fieldset>
  <figcaption class="sampling-demo-caption">
    <b>Рис. {figure}.</b> <span data-caption>{samplingCaption(experiment)}</span>
  </figcaption>
</figure>

<script>
  import { initSamplingDemos } from '@/lib/sampling-demo-controller';

  initSamplingDemos();
</script>

<style is:global>
  .sampling-demo {
    container-type: inline-size;
    margin: var(--space-6) 0;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    font-family: var(--font-ui);
    scroll-margin-top: 88px;
  }

  .sampling-demo-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 20px;
  }

  .sampling-demo-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .sampling-demo-name {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }

  /* Отступы — место для подписей делений: они выходят за область построения. */
  .sampling-demo-chart {
    padding: 14px 14px 30px 44px;
    border-block: var(--border-width) solid var(--color-border);
    background: var(--chart-bg);
  }

  .sampling-demo-svg {
    display: block;
    width: 100%;
    height: 256px;
    overflow: visible;
    font-size: var(--text-chart);
    font-variant-numeric: tabular-nums;
  }

  .sampling-demo-grid line {
    stroke: var(--chart-grid);
    stroke-width: 1;
  }

  .sampling-demo-axis {
    stroke: var(--chart-axis);
    stroke-width: 1;
  }

  .sampling-demo-signal,
  .sampling-demo-result {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .sampling-demo-signal {
    stroke: var(--chart-signal);
    stroke-width: 2;
  }

  .sampling-demo-result {
    stroke: var(--chart-result);
    stroke-width: 2.25;
    stroke-dasharray: 6 4;
  }

  .sampling-demo-samples line {
    stroke: var(--chart-sample);
    stroke-width: 1.5;
  }

  .sampling-demo-samples circle {
    fill: var(--chart-bg);
    stroke: var(--chart-sample);
    stroke-width: 2;
  }

  .sampling-demo-ticks {
    fill: var(--chart-label);
  }

  .sampling-demo-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px 20px;
  }

  .sampling-demo-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }

  .sampling-demo-legend li {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .sampling-demo-key {
    flex: none;
  }

  .sampling-demo-key.signal {
    width: 18px;
    height: 2px;
    background: var(--chart-signal);
  }

  .sampling-demo-key.sample {
    width: 10px;
    height: 10px;
    border: 2px solid var(--chart-sample);
    border-radius: 50%;
  }

  .sampling-demo-key.result {
    width: 18px;
    border-top: 2px dashed var(--chart-result);
  }

  .sampling-demo-status {
    --status-color: var(--color-success);

    display: flex;
    gap: 8px;
    align-items: flex-start;
    margin: 0;
    padding: 8px 12px;
    border-radius: var(--radius-md);
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1px var(--status-color);
    font-size: 14px;
    line-height: 1.45;
  }

  .sampling-demo[data-tone='warning'] .sampling-demo-status {
    --status-color: var(--color-warning);
  }

  .sampling-demo[data-tone='error'] .sampling-demo-status {
    --status-color: var(--color-error);
  }

  .sampling-demo-icon {
    display: flex;
    flex: none;
    margin-top: 1px;
    color: var(--status-color);
  }

  .sampling-demo[data-tone='success'] .sampling-demo-icon.alert,
  .sampling-demo:not([data-tone='success']) .sampling-demo-icon.ok {
    display: none;
  }

  .sampling-demo-legend li[hidden] {
    display: none;
  }

  .sampling-demo .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .sampling-demo-controls {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    margin: 0;
    padding: 14px 20px 16px;
    border: 0;
    border-top: var(--border-width) solid var(--color-border);
  }

  .sampling-demo-param {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sampling-demo-param-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
  }

  .sampling-demo-param-head i,
  .sampling-demo-mark i {
    font-family: var(--font-text);
  }

  .sampling-demo-param-head output {
    font-size: 15px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Ползунок: дорожка 4 px с заливкой до значения, бегунок 20 px; отметка 2f — риской на дорожке.
     `--fill` и `--mark` — положение в процентах без единицы: длину нельзя умножать на проценты. */
  .sampling-demo-range {
    --half-thumb: 10px;
    --track:
      linear-gradient(
          to right,
          transparent
            calc(var(--half-thumb) + (100% - 2 * var(--half-thumb)) * var(--mark) / 100 - 1px),
          var(--color-text-muted) 0
            calc(var(--half-thumb) + (100% - 2 * var(--half-thumb)) * var(--mark) / 100 + 1px),
          transparent 0
        )
        center / 100% 12px no-repeat,
      linear-gradient(
          to right,
          var(--color-accent)
            calc(var(--half-thumb) + (100% - 2 * var(--half-thumb)) * var(--fill) / 100),
          var(--color-border) 0
        )
        center / 100% 4px no-repeat;

    width: 100%;
    height: 28px;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: pointer;
    touch-action: pan-y;
  }

  .sampling-demo-range::-webkit-slider-runnable-track {
    height: 28px;
    background: var(--track);
  }

  .sampling-demo-range::-moz-range-track {
    height: 28px;
    background: var(--track);
  }

  .sampling-demo-range::-webkit-slider-thumb {
    width: 20px;
    height: 20px;
    margin-top: 4px;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-sm);
    appearance: none;
  }

  .sampling-demo-range::-moz-range-thumb {
    box-sizing: border-box;
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-sm);
  }

  .sampling-demo-range:focus-visible {
    box-shadow: none;
    outline: none;
  }

  .sampling-demo-range:focus-visible::-webkit-slider-thumb {
    box-shadow: var(--focus-ring);
  }

  .sampling-demo-range:focus-visible::-moz-range-thumb {
    box-shadow: var(--focus-ring);
  }

  .sampling-demo-scale {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 12px;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .sampling-demo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    align-items: center;
    justify-content: space-between;
  }

  .sampling-demo-presets,
  .sampling-demo-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .sampling-demo-buttons {
    gap: 14px;
  }

  .sampling-demo-presets-label {
    margin-right: 2px;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .sampling-demo-preset {
    height: 32px;
    padding: 0 12px;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-text);
    font: 500 14px var(--font-ui);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }

  .sampling-demo-preset[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    font-weight: 600;
  }

  .sampling-demo-switch {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 4px 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font: 400 14px var(--font-ui);
    cursor: pointer;
  }

  .sampling-demo-track {
    position: relative;
    flex: none;
    width: 34px;
    height: 20px;
    border-radius: var(--radius-full);
    background: var(--color-border-strong);
  }

  .sampling-demo-track > span {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-bg);
  }

  .sampling-demo-switch[aria-checked='true'] .sampling-demo-track {
    background: var(--color-accent);
  }

  .sampling-demo-switch[aria-checked='true'] .sampling-demo-track > span {
    left: 17px;
    background: var(--color-on-accent);
  }

  .sampling-demo-reset {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    height: 36px;
    padding: 0 12px;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text);
    font: 500 14px var(--font-ui);
    cursor: pointer;
  }

  @media (hover: hover) {
    .sampling-demo-preset:hover,
    .sampling-demo-reset:hover {
      background: var(--color-bg);
    }

    .sampling-demo-preset[aria-pressed='true']:hover {
      background: var(--color-accent-soft);
    }
  }

  /* Неактивные параметры не выглядят рабочими: приглушены, без указателя; сообщение объясняет причину. */
  .sampling-demo-controls:disabled .sampling-demo-param,
  .sampling-demo-controls:disabled .sampling-demo-actions {
    opacity: 0.5;
  }

  .sampling-demo-controls:disabled * {
    cursor: not-allowed;
  }

  .sampling-demo-audio {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sampling-demo-warning {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 0 0 4px;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    background: var(--color-warning-bg);
    font-size: 14px;
    line-height: 1.45;
  }

  .sampling-demo-warning > svg {
    margin-top: 1px;
    color: var(--color-warning);
  }

  .sampling-demo-warning b {
    color: var(--color-warning);
  }

  .sampling-demo-player {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    padding: 8px 14px 8px 8px;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .sampling-demo-play {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-accent);
    cursor: pointer;
  }

  .sampling-demo-stop,
  .sampling-demo-mute {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .sampling-demo-mute {
    color: var(--color-text-muted);
  }

  .sampling-demo-play-icon,
  .sampling-demo-mute-icon {
    display: flex;
  }

  .sampling-demo-play:not([data-playing]) .sampling-demo-play-icon.pause,
  .sampling-demo-play[data-playing] .sampling-demo-play-icon.start,
  .sampling-demo-mute:not([data-muted]) .sampling-demo-mute-icon.off,
  .sampling-demo-mute[data-muted] .sampling-demo-mute-icon.on {
    display: none;
  }

  .sampling-demo-position {
    display: flex;
    flex: 1 1 160px;
    gap: 10px;
    align-items: center;
    min-width: 160px;
  }

  .sampling-demo-volume {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .sampling-demo-volume .sampling-demo-range {
    width: 72px;
  }

  .sampling-demo-time,
  .sampling-demo-volume-text {
    font-size: 13px;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .sampling-demo-volume-text {
    width: 36px;
  }

  /* Компактный ползунок позиции и громкости: та же дорожка без риски, бегунок 14 px. */
  .sampling-demo-range.compact {
    --half-thumb: 7px;
    --track: linear-gradient(
        to right,
        var(--color-accent)
          calc(var(--half-thumb) + (100% - 2 * var(--half-thumb)) * var(--fill) / 100),
        var(--color-border) 0
      )
      center / 100% 4px no-repeat;

    flex: 1;
    min-width: 0;
    height: 24px;
  }

  .sampling-demo-range.compact::-webkit-slider-runnable-track {
    height: 24px;
  }

  .sampling-demo-range.compact::-moz-range-track {
    height: 24px;
  }

  .sampling-demo-range.compact::-webkit-slider-thumb {
    width: 14px;
    height: 14px;
    margin-top: 5px;
    border: 0;
    background: var(--color-accent);
  }

  .sampling-demo-range.compact::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: 0;
    background: var(--color-accent);
  }

  .sampling-demo-player-state {
    margin: 0;
    font-size: 12px;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .sampling-demo-player[data-mode='error'] + .sampling-demo-player-state {
    color: var(--color-error);
