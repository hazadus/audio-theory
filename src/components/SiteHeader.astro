---
// Шапка: знак, основная навигация, тема и компактное меню. Пункты берутся из navigation.ts.
import Icon from '@/components/Icon.astro';
import ThemeChoice from '@/components/ThemeChoice.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { isActive, navItems } from '@/lib/navigation';
import { siteConfig } from '@/site.config';
import { withBase } from '@/lib/urls';

const items = navItems.map((item) => ({
  ...item,
  href: withBase(item.href),
  active: isActive(item, Astro.url.pathname),
}));
---

<header class="site-header" data-site-header data-pagefind-ignore>
  <div class="bar">
    <a class="brand" href={withBase('/')}>
      Теория аудио
    </a>
    <div class="menu-panel" id="site-menu" data-menu-panel>
      {items.length > 0 && (
        <nav aria-label="Основная навигация">
          <ul>
            {items.map((item) => (
              <li>
                <a href={item.href} aria-current={item.active ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <div class="menu-extra">
        <ThemeChoice />
        <ul class="menu-links">
          <li>
            <a href={`${siteConfig.repository}/issues/new`}>Предложить тему</a>
          </li>
          <li>
            <a href={siteConfig.repository}>
              GitHub
              <Icon name="external-link" size={16} />
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="actions">
      <div class="theme-wide">
        <ThemeToggle />
      </div>
      <button
        type="button"
        class="menu-button"
        data-menu-button
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Меню"
      >
        <span data-menu-icon="open">
          <Icon name="menu" />
        </span>
        <span data-menu-icon="close" hidden>
          <Icon name="x" />
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const button = header?.querySelector<HTMLButtonElement>('[data-menu-button]');
  const panel = header?.querySelector<HTMLElement>('[data-menu-panel]');

  if (header && button && panel) {
    const wide = matchMedia('(width >= 1024px)');
    const isOpen = () => header.hasAttribute('data-menu-open');

    const setOpen = (open: boolean, restoreFocus = false) => {
      header.toggleAttribute('data-menu-open', open);
      button.setAttribute('aria-expanded', String(open));
      for (const icon of button.querySelectorAll<HTMLElement>('[data-menu-icon]')) {
        icon.hidden = (icon.dataset.menuIcon === 'open') === open;
      }
      if (open) panel.querySelector<HTMLElement>('a[href], input:checked, button')?.focus();
      else if (restoreFocus) button.focus();
    };

    button.addEventListener('click', () => setOpen(!isOpen(), true));
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        event.preventDefault();
        setOpen(false, true);
      }
    });
    document.addEventListener('click', (event) => {
      if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
    });
    // Фокус ушёл из шапки с клавиатуры: меню закрывается, фокус остаётся там, куда он перешёл.
    header.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (isOpen() && next && !header.contains(next)) setOpen(false);
    });
    wide.addEventListener('change', () => {
      if (wide.matches && isOpen()) setOpen(false);
    });
    header.setAttribute('data-menu-ready', '');
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: var(--border-width) solid var(--color-border);
    background: var(--color-bg);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    width: min(var(--container-max), 100% - 2 * var(--page-gutter));
    min-height: 56px;
    margin-inline: auto;
  }

  .brand {
    color: var(--color-text);
    font-family: var(--font-text);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .menu-panel,
  nav ul,
  .menu-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
  }

  nav a,
  .menu-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 40px;
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    text-decoration: none;
  }

  nav a:hover,
  .menu-links a:hover {
    color: var(--color-accent-hover);
  }

  /* Текущая страница: линия, вес 600 и aria-current — не только цвет. */
  nav a[aria-current='page'] {
    font-weight: 600;
    box-shadow: inset 0 calc(-1 * var(--border-width-strong)) 0 var(--color-accent);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
  }

  .menu-button {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    color: var(--color-text);
    cursor: pointer;
  }

  .menu-button span {
    display: inline-flex;
  }

  .menu-button [hidden] {
    display: none;
  }

  .menu-extra {
    display: none;
  }

  @media (width >= 1024px) {
    .bar {
      min-height: 64px;
    }

    .menu-panel {
      display: contents;
    }
  }

  @media (width < 1024px) {
    .theme-wide {
      display: none;
    }

    .menu-panel {
      flex: 1 1 100%;
      order: 3;
      padding-bottom: var(--space-3);
    }

    .bar {
      flex-wrap: wrap;
      row-gap: 0;
    }

    /* Без JS навигация остаётся в строке под знаком; с JS она сворачивается в меню. */
    [data-menu-ready] .menu-button {
      display: inline-flex;
    }

    [data-menu-ready] .menu-panel {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      display: none;
      max-height: calc(100dvh - 100%);
      overflow-y: auto;
      padding: var(--space-4) var(--page-gutter) var(--space-6);
      border-bottom: var(--border-width) solid var(--color-border);
      background: var(--color-surface-raised);
      box-shadow: var(--shadow-md);
    }

    [data-menu-open] .menu-panel {
      display: block;
    }

    [data-menu-ready] nav {
      margin-bottom: var(--space-4);
    }

    [data-menu-ready] nav ul {
      flex-direction: column;
      gap: 0;
    }

    [data-menu-ready] nav a {
      min-height: 44px;
    }

    [data-menu-ready] .menu-extra {
      display: grid;
      gap: var(--space-4);
    }

    [data-menu-ready] .menu-links a {
      min-height: 44px;
    }
  }
</style>
