# Каталог статей вместо src/content/articles (только для проверок).
# Публикуемая сборка переменную не использует.
# ARTICLES_DIR=./tests/fixtures/articles/valid

# Локальная сборка новой статьи до коммита: файл без Git-даты показывается как «Черновик».
# Публикуемая сборка и CI переменную не задают; без неё отсутствие даты — ошибка.
# Dev-сервер включает этот режим сам.
# ALLOW_DRAFT_ARTICLES=1
