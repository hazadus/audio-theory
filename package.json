{
  "name": "audio-theory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test:mdx": "node scripts/check-mdx.mjs",
    "test:articles": "node scripts/check-articles.mjs",
    "preview": "astro preview",
    "fmt": "prettier --write \"**/*.{astro,css,js,mjs,ts,json}\"",
    "fmt:check": "prettier --check \"**/*.{astro,css,js,mjs,ts,json}\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:production": "node scripts/test-production.mjs",
    "test:e2e": "npm run build -- --base / --outDir .e2e/root && npm run build -- --base /audio-theory/ --outDir .e2e/prefixed && playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/mdx": "8.0.2",
    "astro": "7.3.5",
    "katex": "0.16.47",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "pagefind": "1.5.2",
    "parse5": "8.0.1",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
